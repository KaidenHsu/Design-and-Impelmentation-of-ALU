HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     foreach {key value} [list \
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         schema 1 \
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         period_ns $Clk_period_ns \
