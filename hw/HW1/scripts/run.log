HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     # Find the worst setup slack across all path groups, not only one group.
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     set worst ""
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     foreach_in_collection group [get_path_groups *] {
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         set paths [get_timing_paths \
