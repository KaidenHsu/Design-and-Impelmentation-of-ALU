HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     }
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis] 
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     # [Report Timing]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     # Restore the TA console report and keep the detailed report file.
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     report_timing -significant_digits 6 -sort_by group
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     redirect -file [file join $Path_Syn timing_report.txt] {
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         report_timing -path full -delay max -significant_digits 6 -sort_by group
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     }
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis] 
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     # Find the worst setup slack across all path groups, not only one group.
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     set worst ""
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     foreach_in_collection group [get_path_groups *] {
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         set paths [get_timing_paths \
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]             -group [get_object_name $group] -delay max -max_paths 1 -nworst 1]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         foreach_in_collection path $paths {
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]             set slack [get_attribute $path slack]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]             if {![string is double -strict $slack]} {
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]                 error "Invalid timing attribute"
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]             }
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]             if {$worst eq "" || $slack < $worst} {
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]                 set worst $slack
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]             }
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         }
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     }
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     if {$worst eq ""} {
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         error "No constrained max-delay timing paths"
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     }
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis] 
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     # Reported delay follows the TA's data-arrival-time convention.
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     # Slack remains separate and is used only for timing feasibility/tuning.
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     set critical_delay [dict get \
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         [timing_arrival [file join $Path_Syn timing_report.txt]] delay]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis] 
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     # [Report Area]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     # Use the documented TA library um2 convention, without guessed scaling.
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     redirect -variable area_text {report_area -hier -nosplit}
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     set fd [open [file join $Path_Syn area_report.txt] w]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     puts $fd $area_text
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     close $fd
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     set comb [numeric_area $area_text {Combinational area}]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     set seq [numeric_area $area_text {Noncombinational area}]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     set total [numeric_area $area_text {Total cell area}]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis] 
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     # [Report Power]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     # Keep the TA effort setting and convert explicit report suffixes to W.
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     # Unavailable power fields stay blank rather than becoming invented zeros.
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     set dynamic ""
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     set leakage ""
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     set power ""
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     if {[catch {
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         redirect -variable power_text {report_power -analysis_effort low}
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     } issue]} {
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         puts "WARN: power report unavailable: $issue"
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     } else {
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         set fd [open [file join $Path_Syn power_report.txt] w]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         puts $fd $power_text
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         close $fd
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         if {[regexp {Total Dynamic Power\s*=\s*([0-9.eE+-]+)\s*([munp]?W)} $power_text all number unit]} {
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]             set dynamic [unit_scale $number $unit power]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         }
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         if {[regexp {Cell Leakage Power\s*=\s*([0-9.eE+-]+)\s*([munp]?W)} $power_text all number unit]} {
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]             set leakage [unit_scale $number $unit power]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         }
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         if {$dynamic ne "" && $leakage ne ""} {
