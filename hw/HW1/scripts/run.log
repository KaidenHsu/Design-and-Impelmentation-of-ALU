HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]     # Keep the TA effort setting and convert explicit report suffixes to W.
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]     # Unavailable power fields stay blank rather than becoming invented zeros.
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]     set dynamic ""
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]     set leakage ""
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]     set power ""
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]     if {[catch {
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]         redirect -variable power_text {report_power -analysis_effort low}
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]     } issue]} {
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]         puts "WARN: power report unavailable: $issue"
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]     } else {
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]         set fd [open [file join $Path_Syn power_report.txt] w]
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]         puts $fd $power_text
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]         close $fd
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]         if {[regexp {Total Dynamic Power\s*=\s*([0-9.eE+-]+)\s*([munp]?W)} $power_text all number unit]} {
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]             set dynamic [unit_scale $number $unit power]
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]         }
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]         if {[regexp {Cell Leakage Power\s*=\s*([0-9.eE+-]+)\s*([munp]?W)} $power_text all number unit]} {
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]             set leakage [unit_scale $number $unit power]
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]         }
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]         if {$dynamic ne "" && $leakage ne ""} {
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]             set power [expr {$dynamic + $leakage}]
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]         } else {
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]             puts "WARN: power units/values not extracted; inspect power_report.txt"
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]         }
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]     }
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis] 
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]     # [Each Pipeline Delay]
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]     # Actual register-bank boundaries replace the TA's example m1/* ... m7/*.
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]     # Full path reports provide evidence; stages.tsv feeds report collection.
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]     set sf [open [file join $Path_Syn stages.tsv] w]
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]     for {set i 1} {$i <= $stages && $stages > 1} {incr i} {
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]         set delay ""
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]         set start ""
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]         set end ""
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]         set status unmapped
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis] 
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]         if {[dict exists $stage_maps $Design] && [llength [dict get $stage_maps $Design]] >= $i} {
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]             set mapping [lindex [dict get $stage_maps $Design] [expr {$i - 1}]]
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]             if {[catch {
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]                 set from [boundary [dict get $mapping from]]
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]                 set to [boundary [dict get $mapping to]]
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]                 if {![sizeof_collection $from] || ![sizeof_collection $to]} {
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]                     error "Empty stage boundary"
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]                 }
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis] 
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]                 redirect -file [file join $Path_Syn timing_report_stage${i}.txt] {
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]                     report_timing -from $from -to $to -path full -delay max \
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]                         -nworst 1 -max_paths 1 -significant_digits 6 -sort_by group
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]                 }
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]                 set measured [timing_arrival \
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]                     [file join $Path_Syn timing_report_stage${i}.txt]]
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]                 set delay [expr {[dict get $measured delay] * $time_ns}]
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]                 set start [dict get $measured start]
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]                 set end [dict get $measured end]
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]                 set status measured
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]             } issue]} {
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]                 set status invalid
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]                 puts "WARN: stage $i: $issue"
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]                 set delay ""
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]             }
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]         } else {
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]             puts "WARN: $Design stage $i mapping is not configured"
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]         }
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]         puts $sf "$i\t$delay\t$start\t$end\t$status"
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]     }
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]     close $sf
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis] 
