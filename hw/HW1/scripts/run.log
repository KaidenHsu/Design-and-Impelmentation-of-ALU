HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]         }
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]         create_clock -name $Clk_pin -period $Clk_period $Clock_port
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]         set_fix_hold [get_clocks $Clk_pin]
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]         set_dont_touch_network [get_clocks $Clk_pin]
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]         set_ideal_network $Clock_port
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]         set_input_delay 0 -clock $Clk_pin \
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]             [remove_from_collection [all_inputs] $Clock_port]
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]     }
