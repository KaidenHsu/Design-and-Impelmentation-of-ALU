HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis] # Convert time to ns and power to W for machine-readable measurements.
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis] proc unit_scale {number suffix kind} {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set scales [dict create \
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         s 1e9 \
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         ms 1e6 \
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         us 1e3 \
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         ns 1 \
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         ps 1e-3 \
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         fs 1e-6 \
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         W 1 \
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         mW 1e-3 \
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         uW 1e-6 \
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         nW 1e-9 \
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         pW 1e-12]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     if {![dict exists $scales $suffix]} {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         error "Unsupported $kind unit: $suffix"
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     return [expr {double($number) * [dict get $scales $suffix]}]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis] }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis] # Extract reported data arrival time and its path endpoints.
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis] proc timing_arrival {filename} {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     # Read the positive arrival line, not the negative slack-subtraction line.
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     # Reports can contain one worst path per group; retain the largest arrival.
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set fd [open $filename r]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set text [read $fd]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     close $fd
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set result ""
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     foreach block [split [string map [list "Startpoint:" "\u0001"] $text] "\u0001"] {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         if {[regexp -line \
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]             {^[ \t]*data arrival time[ \t]+([0-9]+\.?[0-9]*(?:[eE][+-]?[0-9]+)?)[ \t\r]*$} $block all number]} {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]             if {$result eq "" || $number > [dict get $result delay]} {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]                 regexp {^[ \t]*([^ \t\n]+)} $block all start
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]                 regexp -line {^[ \t]*Endpoint:[ \t]+([^ \t\n]+)} $block all end
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]                 set result [dict create delay $number start $start end $end]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]             }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     if {$result eq ""} {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         error "No positive data arrival time in $filename"
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     return $result
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis] }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis] # Resolve stage boundaries to data ports or register pins, excluding clk/rst.
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis] proc boundary {pattern} {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     if {$pattern eq "INPUTS"} {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         set ports [all_inputs]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         foreach name {clk rst} {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]             set control [get_ports -quiet $name]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]             if {[sizeof_collection $control]} {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]                 set ports [remove_from_collection $ports $control]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]             }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         return $ports
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     if {$pattern eq "OUTPUTS"} {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         return [all_outputs]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     return [get_pins -hierarchical -quiet $pattern]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis] }
