HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]     set coverage_status clean
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]     if {[regexp -nocase {Warning:|Error:} $coverage]} {
