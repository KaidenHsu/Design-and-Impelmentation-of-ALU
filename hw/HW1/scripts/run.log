HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]                 }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]                 redirect -file [file join $Path_Syn timing_report_stage${i}.txt] {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]                     report_timing -from $from -to $to -path full -delay max \
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]                         -nworst 1 -max_paths 1 -significant_digits 6 -sort_by group
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]                 }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]                 set measured [timing_arrival \
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]                     [file join $Path_Syn timing_report_stage${i}.txt]]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]                 set delay [expr {[dict get $measured delay] * $time_ns}]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]                 set start [dict get $measured start]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]                 set end [dict get $measured end]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]                 set status measured
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]             } issue]} {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]                 set status invalid
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]                 puts "WARN: stage $i: $issue"
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]                 set delay ""
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]             }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         } else {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]             puts "WARN: $Design stage $i mapping is not configured"
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         puts $sf "$i\t$delay\t$start\t$end\t$status"
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     close $sf
