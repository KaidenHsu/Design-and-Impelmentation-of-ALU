HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis] 
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     # Variants reuse top-module names but compile from separate RTL folders.
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     set configurations [dict create \
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         FXP_adder {FXP_adder 1} \
