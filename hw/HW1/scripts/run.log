HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     checked [list write_sdc [file join $Path_Syn constraints.sdc]]
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis] 
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     # [Automation Measurements]
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     # Stable keys feed period tuning/CSV collection. Preserve raw numeric precision.
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     set fd [open [file join $Path_Syn metrics.tsv] w]
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     foreach {key value} [list \
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]         schema 1 \
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]         period_ns $Clk_period_ns \
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]         slack_ns [expr {$worst * $time_ns}] \
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]         delay_ns [expr {$critical_delay * $time_ns}] \
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]         delay_basis timing_report_data_arrival \
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]         time_unit_ns $time_ns \
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]         comb_um2 $comb \
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]         seq_um2 $seq \
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]         total_um2 $total \
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]         dynamic_w $dynamic \
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]         leakage_w $leakage \
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]         power_w $power \
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]         power_activity default_estimated \
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]         area_units TA_library_um2 \
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]         sdf_corner min_typ_max \
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]         coverage_status $coverage_status \
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]         complete 1] {
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]         puts $fd "$key\t$value"
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     }
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     close $fd
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis] 
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     # TA optional example remains disabled; do not introduce clock-gating analysis.
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     # report_clock_gating -gating_elements
