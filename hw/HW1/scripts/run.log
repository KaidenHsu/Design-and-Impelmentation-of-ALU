HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     set seq [numeric_area $area_text {Noncombinational area}]
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     set total [numeric_area $area_text {Total cell area}]
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis] 
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     # [Report Power]
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     # Keep the TA effort setting and convert explicit report suffixes to W.
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     # Unavailable power fields stay blank rather than becoming invented zeros.
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     set dynamic ""
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     set leakage ""
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     set power ""
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     if {[catch {
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         redirect -variable power_text {report_power -analysis_effort low}
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     } issue]} {
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         puts "WARN: power report unavailable: $issue"
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     } else {
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         set fd [open [file join $Path_Syn power_report.txt] w]
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         puts $fd $power_text
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         close $fd
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         if {[regexp {Total Dynamic Power\s*=\s*([0-9.eE+-]+)\s*([munp]?W)} $power_text all number unit]} {
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]             set dynamic [unit_scale $number $unit power]
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         }
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         if {[regexp {Cell Leakage Power\s*=\s*([0-9.eE+-]+)\s*([munp]?W)} $power_text all number unit]} {
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]             set leakage [unit_scale $number $unit power]
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         }
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         if {$dynamic ne "" && $leakage ne ""} {
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]             set power [expr {$dynamic + $leakage}]
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         } else {
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]             puts "WARN: power units/values not extracted; inspect power_report.txt"
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         }
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis] 
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     # [Each Pipeline Delay]
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     # Actual register-bank boundaries replace the TA's example m1/* ... m7/*.
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     # Full path reports provide evidence; stages.tsv feeds report collection.
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     set sf [open [file join $Path_Syn stages.tsv] w]
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     for {set i 1} {$i <= $stages && $stages > 1} {incr i} {
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         set delay ""
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         set start ""
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         set end ""
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         set status unmapped
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis] 
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         if {[dict exists $stage_maps $Design] && [llength [dict get $stage_maps $Design]] >= $i} {
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]             set mapping [lindex [dict get $stage_maps $Design] [expr {$i - 1}]]
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]             if {[catch {
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]                 set from [boundary [dict get $mapping from]]
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]                 set to [boundary [dict get $mapping to]]
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]                 if {![sizeof_collection $from] || ![sizeof_collection $to]} {
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]                     error "Empty stage boundary"
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]                 }
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis] 
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]                 redirect -file [file join $Path_Syn timing_report_stage${i}.txt] {
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]                     report_timing -from $from -to $to -path full -delay max \
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]                         -nworst 1 -max_paths 1 -significant_digits 6 -sort_by group
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]                 }
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]                 set measured [timing_arrival \
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]                     [file join $Path_Syn timing_report_stage${i}.txt]]
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]                 set delay [expr {[dict get $measured delay] * $time_ns}]
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]                 set start [dict get $measured start]
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]                 set end [dict get $measured end]
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]                 set status measured
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]             } issue]} {
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]                 set status invalid
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]                 puts "WARN: stage $i: $issue"
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]                 set delay ""
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]             }
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         } else {
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]             puts "WARN: $Design stage $i mapping is not configured"
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         }
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         puts $sf "$i\t$delay\t$start\t$end\t$status"
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     close $sf
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis] 
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     # [Write Out]
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     # Keep TA commands/options; fixed filenames maintain the automation interface.
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     checked [list write -hierarchy -format ddc \
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         -output [file join $Path_Syn design.ddc]]
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     checked [list write -format verilog -hierarchy \
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         -output [file join $Path_Syn ${Dump_file_name}.v]]
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     checked [list write_sdf -version 2.1 -context verilog \
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         [file join $Path_Syn timing.sdf]]
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     checked [list write_sdc [file join $Path_Syn constraints.sdc]]
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis] 
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     # [Automation Measurements]
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     # Stable keys feed period tuning/CSV collection. Preserve raw numeric precision.
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     set fd [open [file join $Path_Syn metrics.tsv] w]
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     foreach {key value} [list \
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         schema 1 \
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         period_ns $Clk_period_ns \
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         slack_ns [expr {$worst * $time_ns}] \
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         delay_ns [expr {$critical_delay * $time_ns}] \
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         delay_basis timing_report_data_arrival \
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         time_unit_ns $time_ns \
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         comb_um2 $comb \
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         seq_um2 $seq \
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         total_um2 $total \
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         dynamic_w $dynamic \
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         leakage_w $leakage \
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         power_w $power \
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         power_activity default_estimated \
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         area_units TA_library_um2 \
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         sdf_corner min_typ_max \
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         coverage_status $coverage_status \
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         complete 1] {
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         puts $fd "$key\t$value"
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     close $fd
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis] 
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     # TA optional example remains disabled; do not introduce clock-gating analysis.
