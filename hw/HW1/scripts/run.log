HW1_LOG_ONLY:[FLP_mul/Area/Synthesis]                         -nworst 1 -max_paths 1 -significant_digits 6 -sort_by group
HW1_LOG_ONLY:[FLP_mul/Area/Synthesis]                 }
HW1_LOG_ONLY:[FLP_mul/Area/Synthesis]                 set measured [timing_arrival \
