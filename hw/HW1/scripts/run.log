HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis] 
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     # [Library and Tool Setup: Original TA Settings]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     set library_root [env_or HW1_LIBRARY_ROOT \
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         /cad/CBDK/ADFP/Executable_Package/Collaterals/IP/stdcell/N16ADFP_StdCell/CCS]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     set ::search_path [concat [list $library_root $Path_Top] $::search_path]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     set ::target_library [list \
