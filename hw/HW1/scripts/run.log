HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     foreach {key value} [list \
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         schema 1 \
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         period_ns $Clk_period_ns \
