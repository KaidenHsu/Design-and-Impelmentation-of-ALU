HW1_LOG_ONLY:[FLP_mul/Between/Synthesis]                         -nworst 1 -max_paths 1 -significant_digits 6 -sort_by group
HW1_LOG_ONLY:[FLP_mul/Between/Synthesis]                 }
HW1_LOG_ONLY:[FLP_mul/Between/Synthesis]                 set measured [timing_arrival \
HW1_LOG_ONLY:[FLP_mul/Between/Synthesis]                     [file join $Path_Syn timing_report_stage${i}.txt]]
HW1_LOG_ONLY:[FLP_mul/Between/Synthesis]                 set delay [expr {[dict get $measured delay] * $time_ns}]
HW1_LOG_ONLY:[FLP_mul/Between/Synthesis]                 set start [dict get $measured start]
HW1_LOG_ONLY:[FLP_mul/Between/Synthesis]                 set end [dict get $measured end]
HW1_LOG_ONLY:[FLP_mul/Between/Synthesis]                 set status measured
HW1_LOG_ONLY:[FLP_mul/Between/Synthesis]             } issue]} {
