HW1_LOG_ONLY:[FLP_adder/Between/Synthesis] NSYSU2026ALU
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis] set Designer "Kaiden Hsu"
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis] Kaiden Hsu
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis] # Pipeline pin patterns include significand, exponent and sign register banks.
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis] # FLP_mul_3 has two internal register banks and a combinational output stage.
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis] set stage_maps [dict create]
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis] dict set stage_maps FLP_mul_3 [list \
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     [dict create from INPUTS to {s1_*_reg*/D}] \
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     [dict create from {s1_*_reg*/Q*} to {s2_*_reg*/D}] \
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     [dict create from {s2_*_reg*/Q*} to OUTPUTS]]
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis] FLP_mul_3 {{from INPUTS to s1_*_reg*/D} {from s1_*_reg*/Q* to s2_*_reg*/D} {from s2_*_reg*/Q* to OUTPUTS}}
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis] # Adders use s<N>_ register banks for every data and sideband signal.
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis] dict set stage_maps FLP_adder_4 [list \
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     [dict create from INPUTS to {s1_*_reg*/D}] \
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     [dict create from {s1_*_reg*/Q*} to {s2_*_reg*/D}] \
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     [dict create from {s2_*_reg*/Q*} to {s3_*_reg*/D}] \
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     [dict create from {s3_*_reg*/Q*} to OUTPUTS]]
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis] FLP_mul_3 {{from INPUTS to s1_*_reg*/D} {from s1_*_reg*/Q* to s2_*_reg*/D} {from s2_*_reg*/Q* to OUTPUTS}} FLP_adder_4 {{from INPUTS to s1_*_reg*/D} {from s1_*_reg*/Q* to s2_*_reg*/D} {from s2_*_reg*/Q* to s3_*_reg*/D} {from s3_*_reg*/Q* to OUTPUTS}}
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis] dict set stage_maps FLP_adder_7 [list \
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     [dict create from INPUTS to {s1_*_reg*/D}] \
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     [dict create from {s1_*_reg*/Q*} to {s2_*_reg*/D}] \
