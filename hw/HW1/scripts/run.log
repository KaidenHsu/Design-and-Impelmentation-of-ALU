HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     set coverage_status clean
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     if {[regexp -nocase {Warning:|Error:} $coverage]} {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         set coverage_status reviewed_with_warnings
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     if {[regexp -nocase {Warning:|Error:} $coverage] && [env_or HW1_TIMING_REVIEWED 0] ne "1"} {
