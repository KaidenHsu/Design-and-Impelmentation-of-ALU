HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     # Find the worst setup slack across all path groups, not only one group.
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     set worst ""
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     foreach_in_collection group [get_path_groups *] {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         set paths [get_timing_paths \
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]             -group [get_object_name $group] -delay max -max_paths 1 -nworst 1]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         foreach_in_collection path $paths {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]             set slack [get_attribute $path slack]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]             if {![string is double -strict $slack]} {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]                 error "Invalid timing attribute"
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]             }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]             if {$worst eq "" || $slack < $worst} {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]                 set worst $slack
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]             }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     if {$worst eq ""} {
