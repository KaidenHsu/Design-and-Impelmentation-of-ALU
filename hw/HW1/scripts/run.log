HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         foreach_in_collection path $paths {
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]             set slack [get_attribute $path slack]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]             if {![string is double -strict $slack]} {
