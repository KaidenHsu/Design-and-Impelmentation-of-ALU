HW1_LOG_ONLY:[FLP_mul/Between/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul/Between/Synthesis]     set suffix [string tolower $suffix]
HW1_LOG_ONLY:[FLP_mul/Between/Synthesis]     if {$suffix in {second seconds}} {
HW1_LOG_ONLY:[FLP_mul/Between/Synthesis]         set suffix s
HW1_LOG_ONLY:[FLP_mul/Between/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul/Between/Synthesis]     set time_ns [unit_scale $un $suffix time]
HW1_LOG_ONLY:[FLP_mul/Between/Synthesis]     if {$time_ns <= 0} {
HW1_LOG_ONLY:[FLP_mul/Between/Synthesis]         error "Library time unit must be positive"
HW1_LOG_ONLY:[FLP_mul/Between/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul/Between/Synthesis]     puts "HW1_DC_UNITS: one library time unit = $time_ns ns"
