HW1_LOG_ONLY:[FLP_adder_7/Delay/Synthesis]     # Find the worst setup slack across all path groups, not only one group.
HW1_LOG_ONLY:[FLP_adder_7/Delay/Synthesis]     set worst ""
HW1_LOG_ONLY:[FLP_adder_7/Delay/Synthesis]     foreach_in_collection group [get_path_groups *] {
