HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     # [Setting Clock Constraints]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     # Combinational variants use the TA's virtual-clock/max-delay alternative.
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     # Pipelines use the physical clk port and the original clock-network settings.
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     if {$stages == 1} {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         set_max_delay $Clk_period -from [all_inputs] -to [all_outputs]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         create_clock -name $Clk_pin -period $Clk_period
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         set_input_delay 0 -clock $Clk_pin [all_inputs]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     } else {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         set Clock_port [get_ports -quiet $Clk_pin]
