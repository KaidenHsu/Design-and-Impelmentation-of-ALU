HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]     # Analyze/elaborate preserves parameter support and round-local WORK isolation.
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]     set fd [open [need_env HW1_RTL_LIST] r]
