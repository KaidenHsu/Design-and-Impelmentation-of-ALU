HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         FLP_adder {FLP_adder 1} \
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         FLP_adder_7 {FLP_adder 7} \
