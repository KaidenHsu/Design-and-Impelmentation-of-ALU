HW1_LOG_ONLY:[FXP_adder/Between/Synthesis]     }
HW1_LOG_ONLY:[FXP_adder/Between/Synthesis] 
HW1_LOG_ONLY:[FXP_adder/Between/Synthesis]     # Find the worst setup slack across all path groups, not only one group.
HW1_LOG_ONLY:[FXP_adder/Between/Synthesis]     set worst ""
HW1_LOG_ONLY:[FXP_adder/Between/Synthesis]     foreach_in_collection group [get_path_groups *] {
HW1_LOG_ONLY:[FXP_adder/Between/Synthesis]         set paths [get_timing_paths \
HW1_LOG_ONLY:[FXP_adder/Between/Synthesis]             -group [get_object_name $group] -delay max -max_paths 1 -nworst 1]
HW1_LOG_ONLY:[FXP_adder/Between/Synthesis]         foreach_in_collection path $paths {
HW1_LOG_ONLY:[FXP_adder/Between/Synthesis]             set slack [get_attribute $path slack]
HW1_LOG_ONLY:[FXP_adder/Between/Synthesis]             if {![string is double -strict $slack]} {
HW1_LOG_ONLY:[FXP_adder/Between/Synthesis]                 error "Invalid timing attribute"
HW1_LOG_ONLY:[FXP_adder/Between/Synthesis]             }
HW1_LOG_ONLY:[FXP_adder/Between/Synthesis]             if {$worst eq "" || $slack < $worst} {
HW1_LOG_ONLY:[FXP_adder/Between/Synthesis]                 set worst $slack
HW1_LOG_ONLY:[FXP_adder/Between/Synthesis]             }
HW1_LOG_ONLY:[FXP_adder/Between/Synthesis]         }
HW1_LOG_ONLY:[FXP_adder/Between/Synthesis]     }
