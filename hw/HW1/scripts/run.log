HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]     # Pipelines use the physical clk port and the original clock-network settings.
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]     if {$stages == 1} {
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]         set_max_delay $Clk_period -from [all_inputs] -to [all_outputs]
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]         create_clock -name $Clk_pin -period $Clk_period
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]         set_input_delay 0 -clock $Clk_pin [all_inputs]
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]     } else {
