HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]     redirect -variable area_text {report_area -hier -nosplit}
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]     set fd [open [file join $Path_Syn area_report.txt] w]
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]     puts $fd $area_text
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]     close $fd
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]     set comb [numeric_area $area_text {Combinational area}]
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]     set seq [numeric_area $area_text {Noncombinational area}]
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]     set total [numeric_area $area_text {Total cell area}]
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis] 
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]     # [Report Power]
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]     # Keep the TA effort setting and convert explicit report suffixes to W.
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]     # Unavailable power fields stay blank rather than becoming invented zeros.
