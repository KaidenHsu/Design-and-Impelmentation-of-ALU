HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     # Use the launcher's ordered source list instead of the TA's example paths.
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     # Analyze/elaborate preserves parameter support and round-local WORK isolation.
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     set fd [open [need_env HW1_RTL_LIST] r]
