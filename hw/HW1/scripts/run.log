HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]         ms 1e6 \
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]         us 1e3 \
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]         ns 1 \
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]         ps 1e-3 \
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]         fs 1e-6 \
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]         W 1 \
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]         mW 1e-3 \
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]         uW 1e-6 \
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]         nW 1e-9 \
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]         pW 1e-12]
