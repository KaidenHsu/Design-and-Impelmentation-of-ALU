HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     # Original TA shell preferences; these do not constrain synthesis timing.
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     set ::sh_enable_line_editing true
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     set ::sh_line_editing_mode emacs
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     history keep 100
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     alias h history
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis] 
