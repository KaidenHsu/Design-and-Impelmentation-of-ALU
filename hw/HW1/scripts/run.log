HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]     } else {
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]         set fd [open [file join $Path_Syn power_report.txt] w]
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]         puts $fd $power_text
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]         close $fd
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]         if {[regexp {Total Dynamic Power\s*=\s*([0-9.eE+-]+)\s*([munp]?W)} $power_text all number unit]} {
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]             set dynamic [unit_scale $number $unit power]
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]         }
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]         if {[regexp {Cell Leakage Power\s*=\s*([0-9.eE+-]+)\s*([munp]?W)} $power_text all number unit]} {
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]             set leakage [unit_scale $number $unit power]
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]         }
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]         if {$dynamic ne "" && $leakage ne ""} {
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]             set power [expr {$dynamic + $leakage}]
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]         } else {
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]             puts "WARN: power units/values not extracted; inspect power_report.txt"
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]         }
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]     }
