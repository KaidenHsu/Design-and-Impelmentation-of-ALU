HW1_LOG_ONLY:[FLP_adder/Area/Synthesis]         set_input_delay 0 -clock $Clk_pin \
HW1_LOG_ONLY:[FLP_adder/Area/Synthesis]             [remove_from_collection [all_inputs] $Clock_port]
HW1_LOG_ONLY:[FLP_adder/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder/Area/Synthesis]     set_output_delay 0 -clock $Clk_pin [all_outputs]
