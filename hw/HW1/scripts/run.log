HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] # Required settings identify this design, strategy and isolated round.
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] proc need_env {name} {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     if {![info exists ::env($name)]} {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         error "Missing environment variable $name; use scripts/run.sh"
