HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     [dict create from {s2_*_reg*/Q*} to {s3_*_reg*/D}] \
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     [dict create from {s3_*_reg*/Q*} to {s4_*_reg*/D}] \
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     [dict create from {s4_*_reg*/Q*} to {s5_*_reg*/D}] \
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     [dict create from {s5_*_reg*/Q*} to {s6_*_reg*/D}] \
