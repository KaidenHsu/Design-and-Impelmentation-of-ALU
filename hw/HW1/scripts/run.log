HW1_LOG_ONLY:[FXP_adder/Between/Synthesis]     }
HW1_LOG_ONLY:[FXP_adder/Between/Synthesis]     set suffix [string tolower $suffix]
HW1_LOG_ONLY:[FXP_adder/Between/Synthesis]     if {$suffix in {second seconds}} {
HW1_LOG_ONLY:[FXP_adder/Between/Synthesis]         set suffix s
HW1_LOG_ONLY:[FXP_adder/Between/Synthesis]     }
HW1_LOG_ONLY:[FXP_adder/Between/Synthesis]     set time_ns [unit_scale $un $suffix time]
HW1_LOG_ONLY:[FXP_adder/Between/Synthesis]     if {$time_ns <= 0} {
