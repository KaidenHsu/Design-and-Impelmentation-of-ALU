HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         dynamic_w $dynamic \
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         leakage_w $leakage \
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         power_w $power \
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         power_activity default_estimated \
