HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     # Use the documented TA library um2 convention, without guessed scaling.
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     redirect -variable area_text {report_area -hier -nosplit}
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     set fd [open [file join $Path_Syn area_report.txt] w]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     puts $fd $area_text
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     close $fd
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     set comb [numeric_area $area_text {Combinational area}]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     set seq [numeric_area $area_text {Noncombinational area}]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     set total [numeric_area $area_text {Total cell area}]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     # [Report Power]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     # Keep the TA effort setting and convert explicit report suffixes to W.
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     # Unavailable power fields stay blank rather than becoming invented zeros.
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     set dynamic ""
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     set leakage ""
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     set power ""
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     if {[catch {
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         redirect -variable power_text {report_power -analysis_effort low}
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     } issue]} {
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         puts "WARN: power report unavailable: $issue"
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     } else {
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         set fd [open [file join $Path_Syn power_report.txt] w]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         puts $fd $power_text
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         close $fd
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         if {[regexp {Total Dynamic Power\s*=\s*([0-9.eE+-]+)\s*([munp]?W)} $power_text all number unit]} {
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]             set dynamic [unit_scale $number $unit power]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         }
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         if {[regexp {Cell Leakage Power\s*=\s*([0-9.eE+-]+)\s*([munp]?W)} $power_text all number unit]} {
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]             set leakage [unit_scale $number $unit power]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         }
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         if {$dynamic ne "" && $leakage ne ""} {
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]             set power [expr {$dynamic + $leakage}]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         } else {
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]             puts "WARN: power units/values not extracted; inspect power_report.txt"
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         }
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     }
