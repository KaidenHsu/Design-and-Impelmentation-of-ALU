HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set ::link_library [concat [list *] $::target_library [list dw_foundation.sldb]]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set ::symbol_library {tsmc040.sdb generic.sdb}
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set ::synthetic_library dw_foundation.sldb
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set ::hdlin_translate_off_skip_text "TRUE"
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set ::edifout_netlist_only "TRUE"
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set ::verilogout_no_tri true
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set ::hdlin_enable_presto_for_vhdl "TRUE"
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     # Original TA shell preferences; these do not constrain synthesis timing.
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set ::sh_enable_line_editing true
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set ::sh_line_editing_mode emacs
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     history keep 100
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     alias h history
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     # [Read Design File]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     # Use the launcher's ordered source list instead of the TA's example paths.
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     # Analyze/elaborate preserves parameter support and round-local WORK isolation.
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set fd [open [need_env HW1_RTL_LIST] r]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set files [split [string trim [read $fd]] \n]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     close $fd
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     foreach source $files {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         if {![file isfile $source]} {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]             error "Missing RTL: $source"
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         set ::search_path [concat [list [file dirname $source]] $::search_path]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         set format [expr {[file extension $source] eq ".sv" ? "sverilog" : "verilog"}]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         checked [list analyze -format $format -library WORK $source]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     checked [list elaborate $Top -library WORK]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     current_design $Top
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     checked {link}
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     checked {check_design}
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     # [Time Units]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     # Save the original unit report, then convert the launcher's ns clock period.
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     redirect -variable units {report_units}
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set fd [open [file join $Path_Syn units_report.txt] w]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     puts $fd $units
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     close $fd
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     # In "Time_unit : 1.0e-09 Second(ns)", the number multiplies Second.
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     # The parenthesized ns is a label; do not convert the value twice.
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set unit_pattern {^\s*Time(?:_|\s+)units?\s*:\s*([0-9.eE+-]+)\s*(Seconds?|[munpf]?s)(?:\([^)]*\))?\s*$}
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     if {![regexp -nocase -line $unit_pattern $units match un suffix]} {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         error "Cannot determine library time unit; inspect units_report.txt"
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set suffix [string tolower $suffix]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     if {$suffix in {second seconds}} {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         set suffix s
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set time_ns [unit_scale $un $suffix time]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     if {$time_ns <= 0} {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         error "Library time unit must be positive"
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     puts "HW1_DC_UNITS: one library time unit = $time_ns ns"
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set Clk_period [expr {double($Clk_period_ns) / $time_ns}]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     # [Setting Clock Constraints]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     # Combinational variants use the TA's virtual-clock/max-delay alternative.
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     # Pipelines use the physical clk port and the original clock-network settings.
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     if {$stages == 1} {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         set_max_delay $Clk_period -from [all_inputs] -to [all_outputs]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         create_clock -name $Clk_pin -period $Clk_period
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         set_input_delay 0 -clock $Clk_pin [all_inputs]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     } else {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         set Clock_port [get_ports -quiet $Clk_pin]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         if {![sizeof_collection $Clock_port]} {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]             error "Pipelined top has no $Clk_pin port"
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         create_clock -name $Clk_pin -period $Clk_period $Clock_port
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         set_fix_hold [get_clocks $Clk_pin]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         set_dont_touch_network [get_clocks $Clk_pin]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         set_ideal_network $Clock_port
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         set_input_delay 0 -clock $Clk_pin \
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]             [remove_from_collection [all_inputs] $Clock_port]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set_output_delay 0 -clock $Clk_pin [all_outputs]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     # [Setting Design Environment: Original TA Corners and Wire-Load Model]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     # Do not silently change library corners when refactoring the script.
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set_operating_conditions \
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         -min_library N16ADFP_StdCellff0p88v125c_ccs -min ff0p88v125c \
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         -max_library N16ADFP_StdCellss0p72vm40c_ccs -max ss0p72vm40c
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set_wire_load_model -name ZeroWireload -library N16ADFP_StdCellss0p72vm40c_ccs
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set_wire_load_mode top
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     # [Area Optimization and Compile]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     # Strategies differ by period; retain the same TA compile/max-area commands.
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set_max_area 0
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     checked {compile}
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     # [Change Naming Rule: Original TA Rules]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     # Escaped brackets keep the literal TA allowed-character set in quoted Tcl.
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set ::bus_inference_style {%s[%d]}
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set ::bus_naming_style {%s[%d]}
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set ::hdlout_internal_busses true
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     change_names -hierarchy -rule verilog
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     define_name_rules name_rule -allowed "A-Z a-z 0-9 _" -max_length 255 -type cell
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     define_name_rules name_rule -allowed "A-Z a-z 0-9 _\[\]" -max_length 255 -type net
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     define_name_rules name_rule -map {{"\\*cell\\*" "cell"}} -case_insensitive
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     change_names -hierarchy -rules name_rule
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     remove_unconnected_ports -blast_buses [get_cells -hierarchical *]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     # [Timing Coverage]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     # Period tuning requires constrained timing paths. Save all diagnostics.
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     redirect -variable coverage {check_timing}
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set fd [open [file join $Path_Syn check_timing.txt] w]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     puts $fd $coverage
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     close $fd
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     puts $coverage
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     if {[regexp -nocase {(Warning:|Error:)[^\n]*(unconstrained|not constrained|no clock|no input delay|no output delay)} $coverage]} {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         error "Required timing coverage is missing; correct the constraints before tuning"
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set coverage_status clean
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     if {[regexp -nocase {Warning:|Error:} $coverage]} {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         set coverage_status reviewed_with_warnings
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     if {[regexp -nocase {Warning:|Error:} $coverage] && [env_or HW1_TIMING_REVIEWED 0] ne "1"} {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         error "check_timing diagnostics require review; see check_timing.txt. Use --input-delays-reviewed only after correcting/reviewing coverage."
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     # [Report Timing]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     # Restore the TA console report and keep the detailed report file.
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     report_timing -significant_digits 6 -sort_by group
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     redirect -file [file join $Path_Syn timing_report.txt] {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         report_timing -path full -delay max -significant_digits 6 -sort_by group
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     # Find the worst setup slack across all path groups, not only one group.
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set worst ""
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     foreach_in_collection group [get_path_groups *] {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         set paths [get_timing_paths \
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]             -group [get_object_name $group] -delay max -max_paths 1 -nworst 1]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         foreach_in_collection path $paths {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]             set slack [get_attribute $path slack]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]             if {![string is double -strict $slack]} {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]                 error "Invalid timing attribute"
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]             }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]             if {$worst eq "" || $slack < $worst} {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]                 set worst $slack
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]             }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     if {$worst eq ""} {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         error "No constrained max-delay timing paths"
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     # Reported delay follows the TA's data-arrival-time convention.
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     # Slack remains separate and is used only for timing feasibility/tuning.
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set critical_delay [dict get \
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         [timing_arrival [file join $Path_Syn timing_report.txt]] delay]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     # [Report Area]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     # Use the documented TA library um2 convention, without guessed scaling.
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     redirect -variable area_text {report_area -hier -nosplit}
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set fd [open [file join $Path_Syn area_report.txt] w]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     puts $fd $area_text
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     close $fd
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set comb [numeric_area $area_text {Combinational area}]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set seq [numeric_area $area_text {Noncombinational area}]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set total [numeric_area $area_text {Total cell area}]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     # [Report Power]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     # Keep the TA effort setting and convert explicit report suffixes to W.
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     # Unavailable power fields stay blank rather than becoming invented zeros.
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set dynamic ""
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set leakage ""
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set power ""
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     if {[catch {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         redirect -variable power_text {report_power -analysis_effort low}
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     } issue]} {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         puts "WARN: power report unavailable: $issue"
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     } else {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         set fd [open [file join $Path_Syn power_report.txt] w]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         puts $fd $power_text
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         close $fd
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         if {[regexp {Total Dynamic Power\s*=\s*([0-9.eE+-]+)\s*([munp]?W)} $power_text all number unit]} {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]             set dynamic [unit_scale $number $unit power]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         if {[regexp {Cell Leakage Power\s*=\s*([0-9.eE+-]+)\s*([munp]?W)} $power_text all number unit]} {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]             set leakage [unit_scale $number $unit power]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         if {$dynamic ne "" && $leakage ne ""} {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]             set power [expr {$dynamic + $leakage}]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         } else {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]             puts "WARN: power units/values not extracted; inspect power_report.txt"
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     # [Each Pipeline Delay]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     # Actual register-bank boundaries replace the TA's example m1/* ... m7/*.
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     # Full path reports provide evidence; stages.tsv feeds report collection.
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set sf [open [file join $Path_Syn stages.tsv] w]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     for {set i 1} {$i <= $stages && $stages > 1} {incr i} {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         set delay ""
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         set start ""
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         set end ""
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         set status unmapped
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         if {[dict exists $stage_maps $Design] && [llength [dict get $stage_maps $Design]] >= $i} {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]             set mapping [lindex [dict get $stage_maps $Design] [expr {$i - 1}]]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]             if {[catch {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]                 set from [boundary [dict get $mapping from]]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]                 set to [boundary [dict get $mapping to]]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]                 if {![sizeof_collection $from] || ![sizeof_collection $to]} {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]                     error "Empty stage boundary"
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]                 }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]                 redirect -file [file join $Path_Syn timing_report_stage${i}.txt] {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]                     report_timing -from $from -to $to -path full -delay max \
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]                         -nworst 1 -max_paths 1 -significant_digits 6 -sort_by group
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]                 }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]                 set measured [timing_arrival \
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]                     [file join $Path_Syn timing_report_stage${i}.txt]]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]                 set delay [expr {[dict get $measured delay] * $time_ns}]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]                 set start [dict get $measured start]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]                 set end [dict get $measured end]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]                 set status measured
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]             } issue]} {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]                 set status invalid
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]                 puts "WARN: stage $i: $issue"
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]                 set delay ""
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]             }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         } else {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]             puts "WARN: $Design stage $i mapping is not configured"
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         puts $sf "$i\t$delay\t$start\t$end\t$status"
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     close $sf
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis] 
