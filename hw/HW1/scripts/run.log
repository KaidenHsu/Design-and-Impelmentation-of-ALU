HW1_LOG_ONLY:[FXP_mul/Area/Synthesis]         }
HW1_LOG_ONLY:[FXP_mul/Area/Synthesis]         puts $sf "$i\t$delay\t$start\t$end\t$status"
HW1_LOG_ONLY:[FXP_mul/Area/Synthesis]     }
HW1_LOG_ONLY:[FXP_mul/Area/Synthesis]     close $sf
