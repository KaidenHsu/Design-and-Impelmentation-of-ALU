HW1_LOG_ONLY:[FLP_adder/Area/Synthesis] # Some DC commands return 0 on failure instead of raising a Tcl exception.
HW1_LOG_ONLY:[FLP_adder/Area/Synthesis] proc checked {script} {
HW1_LOG_ONLY:[FLP_adder/Area/Synthesis]     set result [uplevel 1 $script]
HW1_LOG_ONLY:[FLP_adder/Area/Synthesis]     if {$result eq "0"} {
