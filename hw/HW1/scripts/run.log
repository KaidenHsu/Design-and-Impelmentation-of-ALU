HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         $HW1_Root gate_level $Design $Optimization round[need_env HW1_ROUND]]]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     if {$Path_Syn ne $expected} {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         error "Output path does not match the configured design/optimization/round"
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     file mkdir $Path_Syn [file join $Path_Syn work]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     define_design_lib WORK -path [file join $Path_Syn work]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     # [Library and Tool Setup: Original TA Settings]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set library_root [env_or HW1_LIBRARY_ROOT \
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         /cad/CBDK/ADFP/Executable_Package/Collaterals/IP/stdcell/N16ADFP_StdCell/CCS]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set ::search_path [concat [list $library_root $Path_Top] $::search_path]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set ::target_library [list \
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         N16ADFP_StdCellss0p72vm40c_ccs.db \
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         N16ADFP_StdCellff0p88v125c_ccs.db]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     foreach db $::target_library {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         if {![file exists [file join $library_root $db]]} {
