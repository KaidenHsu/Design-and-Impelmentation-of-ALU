HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis] # Convert time to ns and power to W for machine-readable measurements.
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis] proc unit_scale {number suffix kind} {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     set scales [dict create \
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         s 1e9 \
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         ms 1e6 \
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         us 1e3 \
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         ns 1 \
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         ps 1e-3 \
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         fs 1e-6 \
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         W 1 \
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         mW 1e-3 \
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         uW 1e-6 \
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         nW 1e-9 \
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         pW 1e-12]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     if {![dict exists $scales $suffix]} {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         error "Unsupported $kind unit: $suffix"
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     return [expr {double($number) * [dict get $scales $suffix]}]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis] }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis] # Extract reported data arrival time and its path endpoints.
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis] proc timing_arrival {filename} {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     # Read the positive arrival line, not the negative slack-subtraction line.
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     # Reports can contain one worst path per group; retain the largest arrival.
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     set fd [open $filename r]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     set text [read $fd]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     close $fd
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     set result ""
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     foreach block [split [string map [list "Startpoint:" "\u0001"] $text] "\u0001"] {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         if {[regexp -line \
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]             {^[ \t]*data arrival time[ \t]+([0-9]+\.?[0-9]*(?:[eE][+-]?[0-9]+)?)[ \t\r]*$} $block all number]} {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]             if {$result eq "" || $number > [dict get $result delay]} {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]                 regexp {^[ \t]*([^ \t\n]+)} $block all start
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]                 regexp -line {^[ \t]*Endpoint:[ \t]+([^ \t\n]+)} $block all end
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]                 set result [dict create delay $number start $start end $end]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]             }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     if {$result eq ""} {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         error "No positive data arrival time in $filename"
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     return $result
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis] }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis] # Resolve stage boundaries to data ports or register pins, excluding clk/rst.
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis] proc boundary {pattern} {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     if {$pattern eq "INPUTS"} {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         set ports [all_inputs]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         foreach name {clk rst} {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]             set control [get_ports -quiet $name]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]             if {[sizeof_collection $control]} {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]                 set ports [remove_from_collection $ports $control]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]             }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         return $ports
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     if {$pattern eq "OUTPUTS"} {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         return [all_outputs]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     return [get_pins -hierarchical -quiet $pattern]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis] }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis] # Read one numeric area field from the original DC report text.
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis] proc numeric_area {text label} {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     set pattern [format {%s\s*:\s*([0-9.eE+-]+)} $label]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     if {![regexp -- $pattern $text all number]} {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         error "Missing area field: $label"
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     return $number
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis] }
