HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     puts $fd $units
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     close $fd
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     # In "Time_unit : 1.0e-09 Second(ns)", the number multiplies Second.
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     # The parenthesized ns is a label; do not convert the value twice.
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     set unit_pattern {^\s*Time(?:_|\s+)units?\s*:\s*([0-9.eE+-]+)\s*(Seconds?|[munpf]?s)(?:\([^)]*\))?\s*$}
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     if {![regexp -nocase -line $unit_pattern $units match un suffix]} {
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         error "Cannot determine library time unit; inspect units_report.txt"
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     set suffix [string tolower $suffix]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     if {$suffix in {second seconds}} {
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         set suffix s
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     set time_ns [unit_scale $un $suffix time]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     if {$time_ns <= 0} {
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         error "Library time unit must be positive"
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     puts "HW1_DC_UNITS: one library time unit = $time_ns ns"
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     set Clk_period [expr {double($Clk_period_ns) / $time_ns}]
