HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     set ::symbol_library {tsmc040.sdb generic.sdb}
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     set ::synthetic_library dw_foundation.sldb
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     set ::hdlin_translate_off_skip_text "TRUE"
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     set ::edifout_netlist_only "TRUE"
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     set ::verilogout_no_tri true
