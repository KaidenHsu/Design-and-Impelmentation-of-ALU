HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] # Required settings identify this design, strategy and isolated round.
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] proc need_env {name} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     if {![info exists ::env($name)]} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         error "Missing environment variable $name; use scripts/run.sh"
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     return $::env($name)
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] # Some DC commands return 0 on failure instead of raising a Tcl exception.
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] proc checked {script} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set result [uplevel 1 $script]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     if {$result eq "0"} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         error "Command returned failure: $script"
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     return $result
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] # Convert time to ns and power to W for machine-readable measurements.
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] proc unit_scale {number suffix kind} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set scales [dict create \
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         s 1e9 \
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         ms 1e6 \
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         us 1e3 \
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         ns 1 \
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         ps 1e-3 \
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         fs 1e-6 \
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         W 1 \
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         mW 1e-3 \
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         uW 1e-6 \
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         nW 1e-9 \
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         pW 1e-12]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     if {![dict exists $scales $suffix]} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         error "Unsupported $kind unit: $suffix"
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     return [expr {double($number) * [dict get $scales $suffix]}]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] # Extract reported data arrival time and its path endpoints.
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] proc timing_arrival {filename} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # Read the positive arrival line, not the negative slack-subtraction line.
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # Reports can contain one worst path per group; retain the largest arrival.
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set fd [open $filename r]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set text [read $fd]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     close $fd
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set result ""
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     foreach block [split [string map [list "Startpoint:" "\u0001"] $text] "\u0001"] {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         if {[regexp -line \
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]             {^[ \t]*data arrival time[ \t]+([0-9]+\.?[0-9]*(?:[eE][+-]?[0-9]+)?)[ \t\r]*$} $block all number]} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]             if {$result eq "" || $number > [dict get $result delay]} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]                 regexp {^[ \t]*([^ \t\n]+)} $block all start
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]                 regexp -line {^[ \t]*Endpoint:[ \t]+([^ \t\n]+)} $block all end
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]                 set result [dict create delay $number start $start end $end]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]             }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     if {$result eq ""} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         error "No positive data arrival time in $filename"
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     return $result
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] # Resolve stage boundaries to data ports or register pins, excluding clk/rst.
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] proc boundary {pattern} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     if {$pattern eq "INPUTS"} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         set ports [all_inputs]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         foreach name {clk rst} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]             set control [get_ports -quiet $name]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]             if {[sizeof_collection $control]} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]                 set ports [remove_from_collection $ports $control]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]             }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         return $ports
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     if {$pattern eq "OUTPUTS"} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         return [all_outputs]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     return [get_pins -hierarchical -quiet $pattern]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] # Read one numeric area field from the original DC report text.
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] proc numeric_area {text label} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set pattern [format {%s\s*:\s*([0-9.eE+-]+)} $label]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     if {![regexp -- $pattern $text all number]} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         error "Missing area field: $label"
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     return $number
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] proc main {} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     global stage_maps
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # [Paths, Top Module and Clock Configuration]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # Retain the TA names. Path_Top is this variant's RTL directory; Path_Syn
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # is this attempt's gate_level directory. Clk_period is in DC library units.
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set HW1_Root [file normalize [need_env HW1_ROOT]]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set Design [need_env HW1_DESIGN]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set Optimization [need_env HW1_OPT]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set Path_Top [file join $HW1_Root RTL $Design]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set Path_Syn [file normalize [need_env HW1_OUT]]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set Clk_pin "clk"
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set Clk_period_ns [need_env HW1_PERIOD]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # Use the TA basename variable for the Verilog export. Other artifact names
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # stay fixed because post-sim and result collection expect those filenames.
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set Dump_file_name "netlist"
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     if {$Optimization ni {Area Delay Between}} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         error "Unknown optimization $Optimization"
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     if {![string is double -strict $Clk_period_ns] || $Clk_period_ns <= 0} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         error "Invalid period"
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # Variants reuse top-module names but compile from separate RTL folders.
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set configurations [dict create \
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         FXP_adder {FXP_adder 1} \
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         FXP_mul {FXP_mul 1} \
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         FLP_adder {FLP_adder 1} \
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         FLP_adder_7 {FLP_adder 7} \
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         FLP_adder_4 {FLP_adder 4} \
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         FLP_mul {FLP_mul 1} \
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         FLP_mul_3 {FLP_mul 3}]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     if {![dict exists $configurations $Design]} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         error "Unknown design $Design"
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     lassign [dict get $configurations $Design] Top stages
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set expected [file normalize [file join \
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         $HW1_Root gate_level $Design $Optimization round[need_env HW1_ROUND]]]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     if {$Path_Syn ne $expected} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         error "Output path does not match the configured design/optimization/round"
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     file mkdir $Path_Syn [file join $Path_Syn work]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     define_design_lib WORK -path [file join $Path_Syn work]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # [Library and Tool Setup: Original TA Settings]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set library_root [env_or HW1_LIBRARY_ROOT \
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         /cad/CBDK/ADFP/Executable_Package/Collaterals/IP/stdcell/N16ADFP_StdCell/CCS]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set ::search_path [concat [list $library_root $Path_Top] $::search_path]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set ::target_library [list \
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         N16ADFP_StdCellss0p72vm40c_ccs.db \
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         N16ADFP_StdCellff0p88v125c_ccs.db]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     foreach db $::target_library {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         if {![file exists [file join $library_root $db]]} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]             error "Missing library [file join $library_root $db]"
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set ::link_library [concat [list *] $::target_library [list dw_foundation.sldb]]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set ::symbol_library {tsmc040.sdb generic.sdb}
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set ::synthetic_library dw_foundation.sldb
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set ::hdlin_translate_off_skip_text "TRUE"
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set ::edifout_netlist_only "TRUE"
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set ::verilogout_no_tri true
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set ::hdlin_enable_presto_for_vhdl "TRUE"
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # Original TA shell preferences; these do not constrain synthesis timing.
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set ::sh_enable_line_editing true
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set ::sh_line_editing_mode emacs
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     history keep 100
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     alias h history
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # [Read Design File]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # Use the launcher's ordered source list instead of the TA's example paths.
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # Analyze/elaborate preserves parameter support and round-local WORK isolation.
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set fd [open [need_env HW1_RTL_LIST] r]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set files [split [string trim [read $fd]] \n]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     close $fd
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     foreach source $files {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         if {![file isfile $source]} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]             error "Missing RTL: $source"
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         set ::search_path [concat [list [file dirname $source]] $::search_path]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         set format [expr {[file extension $source] eq ".sv" ? "sverilog" : "verilog"}]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         checked [list analyze -format $format -library WORK $source]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     checked [list elaborate $Top -library WORK]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     current_design $Top
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     checked {link}
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     checked {check_design}
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # [Time Units]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # Save the original unit report, then convert the launcher's ns clock period.
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     redirect -variable units {report_units}
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set fd [open [file join $Path_Syn units_report.txt] w]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     puts $fd $units
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     close $fd
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # In "Time_unit : 1.0e-09 Second(ns)", the number multiplies Second.
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # The parenthesized ns is a label; do not convert the value twice.
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set unit_pattern {^\s*Time(?:_|\s+)units?\s*:\s*([0-9.eE+-]+)\s*(Seconds?|[munpf]?s)(?:\([^)]*\))?\s*$}
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     if {![regexp -nocase -line $unit_pattern $units match un suffix]} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         error "Cannot determine library time unit; inspect units_report.txt"
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set suffix [string tolower $suffix]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     if {$suffix in {second seconds}} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         set suffix s
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set time_ns [unit_scale $un $suffix time]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     if {$time_ns <= 0} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         error "Library time unit must be positive"
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     puts "HW1_DC_UNITS: one library time unit = $time_ns ns"
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set Clk_period [expr {double($Clk_period_ns) / $time_ns}]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # [Setting Clock Constraints]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # Combinational variants use the TA's virtual-clock/max-delay alternative.
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # Pipelines use the physical clk port and the original clock-network settings.
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     if {$stages == 1} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         set_max_delay $Clk_period -from [all_inputs] -to [all_outputs]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         create_clock -name $Clk_pin -period $Clk_period
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         set_input_delay 0 -clock $Clk_pin [all_inputs]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     } else {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         set Clock_port [get_ports -quiet $Clk_pin]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         if {![sizeof_collection $Clock_port]} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]             error "Pipelined top has no $Clk_pin port"
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         create_clock -name $Clk_pin -period $Clk_period $Clock_port
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         set_fix_hold [get_clocks $Clk_pin]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         set_dont_touch_network [get_clocks $Clk_pin]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         set_ideal_network $Clock_port
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         set_input_delay 0 -clock $Clk_pin \
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]             [remove_from_collection [all_inputs] $Clock_port]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set_output_delay 0 -clock $Clk_pin [all_outputs]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # [Setting Design Environment: Original TA Corners and Wire-Load Model]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # Do not silently change library corners when refactoring the script.
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set_operating_conditions \
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         -min_library N16ADFP_StdCellff0p88v125c_ccs -min ff0p88v125c \
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         -max_library N16ADFP_StdCellss0p72vm40c_ccs -max ss0p72vm40c
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set_wire_load_model -name ZeroWireload -library N16ADFP_StdCellss0p72vm40c_ccs
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set_wire_load_mode top
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # [Area Optimization and Compile]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # Strategies differ by period; retain the same TA compile/max-area commands.
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set_max_area 0
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     checked {compile}
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # [Change Naming Rule: Original TA Rules]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # Escaped brackets keep the literal TA allowed-character set in quoted Tcl.
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set ::bus_inference_style {%s[%d]}
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set ::bus_naming_style {%s[%d]}
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set ::hdlout_internal_busses true
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     change_names -hierarchy -rule verilog
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     define_name_rules name_rule -allowed "A-Z a-z 0-9 _" -max_length 255 -type cell
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     define_name_rules name_rule -allowed "A-Z a-z 0-9 _\[\]" -max_length 255 -type net
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     define_name_rules name_rule -map {{"\\*cell\\*" "cell"}} -case_insensitive
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     change_names -hierarchy -rules name_rule
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     remove_unconnected_ports -blast_buses [get_cells -hierarchical *]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # [Timing Coverage]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # Period tuning requires constrained timing paths. Save all diagnostics.
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     redirect -variable coverage {check_timing}
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set fd [open [file join $Path_Syn check_timing.txt] w]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     puts $fd $coverage
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     close $fd
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     puts $coverage
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     if {[regexp -nocase {(Warning:|Error:)[^\n]*(unconstrained|not constrained|no clock|no input delay|no output delay)} $coverage]} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         error "Required timing coverage is missing; correct the constraints before tuning"
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set coverage_status clean
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     if {[regexp -nocase {Warning:|Error:} $coverage]} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         set coverage_status reviewed_with_warnings
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     if {[regexp -nocase {Warning:|Error:} $coverage] && [env_or HW1_TIMING_REVIEWED 0] ne "1"} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         error "check_timing diagnostics require review; see check_timing.txt. Use --input-delays-reviewed only after correcting/reviewing coverage."
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # [Report Timing]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # Restore the TA console report and keep the detailed report file.
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     report_timing -significant_digits 6 -sort_by group
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     redirect -file [file join $Path_Syn timing_report.txt] {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         report_timing -path full -delay max -significant_digits 6 -sort_by group
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # Find the worst setup slack across all path groups, not only one group.
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set worst ""
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     foreach_in_collection group [get_path_groups *] {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         set paths [get_timing_paths \
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]             -group [get_object_name $group] -delay max -max_paths 1 -nworst 1]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         foreach_in_collection path $paths {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]             set slack [get_attribute $path slack]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]             if {![string is double -strict $slack]} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]                 error "Invalid timing attribute"
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]             }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]             if {$worst eq "" || $slack < $worst} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]                 set worst $slack
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]             }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     if {$worst eq ""} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         error "No constrained max-delay timing paths"
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # Reported delay follows the TA's data-arrival-time convention.
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # Slack remains separate and is used only for timing feasibility/tuning.
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set critical_delay [dict get \
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         [timing_arrival [file join $Path_Syn timing_report.txt]] delay]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # [Report Area]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # Use the documented TA library um2 convention, without guessed scaling.
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     redirect -variable area_text {report_area -hier -nosplit}
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set fd [open [file join $Path_Syn area_report.txt] w]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     puts $fd $area_text
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     close $fd
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set comb [numeric_area $area_text {Combinational area}]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set seq [numeric_area $area_text {Noncombinational area}]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set total [numeric_area $area_text {Total cell area}]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # [Report Power]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # Keep the TA effort setting and convert explicit report suffixes to W.
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # Unavailable power fields stay blank rather than becoming invented zeros.
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set dynamic ""
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set leakage ""
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set power ""
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     if {[catch {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         redirect -variable power_text {report_power -analysis_effort low}
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     } issue]} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         puts "WARN: power report unavailable: $issue"
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     } else {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         set fd [open [file join $Path_Syn power_report.txt] w]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         puts $fd $power_text
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         close $fd
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         if {[regexp {Total Dynamic Power\s*=\s*([0-9.eE+-]+)\s*([munp]?W)} $power_text all number unit]} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]             set dynamic [unit_scale $number $unit power]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         if {[regexp {Cell Leakage Power\s*=\s*([0-9.eE+-]+)\s*([munp]?W)} $power_text all number unit]} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]             set leakage [unit_scale $number $unit power]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         if {$dynamic ne "" && $leakage ne ""} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]             set power [expr {$dynamic + $leakage}]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         } else {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]             puts "WARN: power units/values not extracted; inspect power_report.txt"
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # [Each Pipeline Delay]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # Actual register-bank boundaries replace the TA's example m1/* ... m7/*.
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # Full path reports provide evidence; stages.tsv feeds report collection.
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     set sf [open [file join $Path_Syn stages.tsv] w]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     for {set i 1} {$i <= $stages && $stages > 1} {incr i} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         set delay ""
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         set start ""
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         set end ""
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         set status unmapped
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         if {[dict exists $stage_maps $Design] && [llength [dict get $stage_maps $Design]] >= $i} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]             set mapping [lindex [dict get $stage_maps $Design] [expr {$i - 1}]]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]             if {[catch {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]                 set from [boundary [dict get $mapping from]]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]                 set to [boundary [dict get $mapping to]]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]                 if {![sizeof_collection $from] || ![sizeof_collection $to]} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]                     error "Empty stage boundary"
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]                 }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]                 redirect -file [file join $Path_Syn timing_report_stage${i}.txt] {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]                     report_timing -from $from -to $to -path full -delay max \
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]                         -nworst 1 -max_paths 1 -significant_digits 6 -sort_by group
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]                 }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]                 set measured [timing_arrival \
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]                     [file join $Path_Syn timing_report_stage${i}.txt]]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]                 set delay [expr {[dict get $measured delay] * $time_ns}]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]                 set start [dict get $measured start]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]                 set end [dict get $measured end]
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]                 set status measured
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]             } issue]} {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]                 set status invalid
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]                 puts "WARN: stage $i: $issue"
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]                 set delay ""
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]             }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         } else {
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]             puts "WARN: $Design stage $i mapping is not configured"
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]         puts $sf "$i\t$delay\t$start\t$end\t$status"
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     close $sf
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_mul/Delay/Synthesis]     # [Write Out]
