HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]             }
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]             if {$worst eq "" || $slack < $worst} {
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]                 set worst $slack
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]             }
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]         }
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]     }
HW1_LOG_ONLY:[FXP_mul/Delay/Synthesis]     if {$worst eq ""} {
