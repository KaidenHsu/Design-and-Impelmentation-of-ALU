HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     # [Time Units]
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     # Save the original unit report, then convert the launcher's ns clock period.
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     redirect -variable units {report_units}
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     set fd [open [file join $Path_Syn units_report.txt] w]
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     puts $fd $units
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     close $fd
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis] 
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     # In "Time_unit : 1.0e-09 Second(ns)", the number multiplies Second.
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     # The parenthesized ns is a label; do not convert the value twice.
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     set unit_pattern {^\s*Time(?:_|\s+)units?\s*:\s*([0-9.eE+-]+)\s*(Seconds?|[munpf]?s)(?:\([^)]*\))?\s*$}
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     if {![regexp -nocase -line $unit_pattern $units match un suffix]} {
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]         error "Cannot determine library time unit; inspect units_report.txt"
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     }
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     set suffix [string tolower $suffix]
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     if {$suffix in {second seconds}} {
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]         set suffix s
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     }
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     set time_ns [unit_scale $un $suffix time]
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     if {$time_ns <= 0} {
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]         error "Library time unit must be positive"
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     }
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     puts "HW1_DC_UNITS: one library time unit = $time_ns ns"
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     set Clk_period [expr {double($Clk_period_ns) / $time_ns}]
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis] 
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     # [Setting Clock Constraints]
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     # Combinational variants use the TA's virtual-clock/max-delay alternative.
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     # Pipelines use the physical clk port and the original clock-network settings.
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     if {$stages == 1} {
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]         set_max_delay $Clk_period -from [all_inputs] -to [all_outputs]
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]         create_clock -name $Clk_pin -period $Clk_period
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]         set_input_delay 0 -clock $Clk_pin [all_inputs]
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     } else {
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]         set Clock_port [get_ports -quiet $Clk_pin]
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]         if {![sizeof_collection $Clock_port]} {
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]             error "Pipelined top has no $Clk_pin port"
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]         }
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]         create_clock -name $Clk_pin -period $Clk_period $Clock_port
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]         set_fix_hold [get_clocks $Clk_pin]
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]         set_dont_touch_network [get_clocks $Clk_pin]
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]         set_ideal_network $Clock_port
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]         set_input_delay 0 -clock $Clk_pin \
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]             [remove_from_collection [all_inputs] $Clock_port]
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     }
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     set_output_delay 0 -clock $Clk_pin [all_outputs]
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis] 
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     # [Setting Design Environment: Original TA Corners and Wire-Load Model]
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     # Do not silently change library corners when refactoring the script.
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     set_operating_conditions \
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]         -min_library N16ADFP_StdCellff0p88v125c_ccs -min ff0p88v125c \
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]         -max_library N16ADFP_StdCellss0p72vm40c_ccs -max ss0p72vm40c
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     set_wire_load_model -name ZeroWireload -library N16ADFP_StdCellss0p72vm40c_ccs
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     set_wire_load_mode top
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis] 
