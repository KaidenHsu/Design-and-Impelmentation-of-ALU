HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]     # [Report Timing]
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]     # Restore the TA console report and keep the detailed report file.
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]     report_timing -significant_digits 6 -sort_by group
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]     redirect -file [file join $Path_Syn timing_report.txt] {
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]         report_timing -path full -delay max -significant_digits 6 -sort_by group
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis] 
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]     # Find the worst setup slack across all path groups, not only one group.
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]     set worst ""
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]     foreach_in_collection group [get_path_groups *] {
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]         set paths [get_timing_paths \
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]             -group [get_object_name $group] -delay max -max_paths 1 -nworst 1]
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]         foreach_in_collection path $paths {
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]             set slack [get_attribute $path slack]
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]             if {![string is double -strict $slack]} {
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]                 error "Invalid timing attribute"
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]             }
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]             if {$worst eq "" || $slack < $worst} {
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]                 set worst $slack
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]             }
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]         }
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]     if {$worst eq ""} {
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]         error "No constrained max-delay timing paths"
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]     }
