HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         foreach_in_collection path $paths {
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]             set slack [get_attribute $path slack]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]             if {![string is double -strict $slack]} {
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]                 error "Invalid timing attribute"
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]             }
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]             if {$worst eq "" || $slack < $worst} {
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]                 set worst $slack
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]             }
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         }
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     if {$worst eq ""} {
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         error "No constrained max-delay timing paths"
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     # Reported delay follows the TA's data-arrival-time convention.
