HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     set fd [open [file join $Path_Syn metrics.tsv] w]
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     foreach {key value} [list \
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         schema 1 \
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         period_ns $Clk_period_ns \
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         slack_ns [expr {$worst * $time_ns}] \
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         delay_ns [expr {$critical_delay * $time_ns}] \
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         delay_basis timing_report_data_arrival \
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         time_unit_ns $time_ns \
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         comb_um2 $comb \
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         seq_um2 $seq \
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         total_um2 $total \
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         dynamic_w $dynamic \
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         leakage_w $leakage \
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         power_w $power \
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         power_activity default_estimated \
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         area_units TA_library_um2 \
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         sdf_corner min_typ_max \
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         coverage_status $coverage_status \
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         complete 1] {
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]         puts $fd "$key\t$value"
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul_3/Area/Synthesis]     close $fd
