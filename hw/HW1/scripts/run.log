HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis] # Read an optional launcher setting, retaining the course default if absent.
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis] proc env_or {name default} {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     if {[info exists ::env($name)]} {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         return $::env($name)
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     return $default
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis] }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis] # Required settings identify this design, strategy and isolated round.
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis] proc need_env {name} {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     if {![info exists ::env($name)]} {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         error "Missing environment variable $name; use scripts/run.sh"
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     return $::env($name)
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis] }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis] # Some DC commands return 0 on failure instead of raising a Tcl exception.
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis] proc checked {script} {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     set result [uplevel 1 $script]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     if {$result eq "0"} {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         error "Command returned failure: $script"
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     return $result
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis] }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis] # Convert time to ns and power to W for machine-readable measurements.
