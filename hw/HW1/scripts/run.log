HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         set ::search_path [concat [list [file dirname $source]] $::search_path]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         set format [expr {[file extension $source] eq ".sv" ? "sverilog" : "verilog"}]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         checked [list analyze -format $format -library WORK $source]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     }
