HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     # Unavailable power fields stay blank rather than becoming invented zeros.
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     set dynamic ""
