HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     set Path_Syn [file normalize [need_env HW1_OUT]]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     set Clk_pin "clk"
