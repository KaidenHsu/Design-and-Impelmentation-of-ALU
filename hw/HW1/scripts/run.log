HW1_LOG_ONLY:[FLP_adder_7/Between/Synthesis] # Read an optional launcher setting, retaining the course default if absent.
HW1_LOG_ONLY:[FLP_adder_7/Between/Synthesis] proc env_or {name default} {
HW1_LOG_ONLY:[FLP_adder_7/Between/Synthesis]     if {[info exists ::env($name)]} {
HW1_LOG_ONLY:[FLP_adder_7/Between/Synthesis]         return $::env($name)
HW1_LOG_ONLY:[FLP_adder_7/Between/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder_7/Between/Synthesis]     return $default
HW1_LOG_ONLY:[FLP_adder_7/Between/Synthesis] }
