HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     # [Paths, Top Module and Clock Configuration]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     # Retain the TA names. Path_Top is this variant's RTL directory; Path_Syn
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     # is this attempt's gate_level directory. Clk_period is in DC library units.
