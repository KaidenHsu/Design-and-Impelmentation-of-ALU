HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     # [Read Design File]
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     # Use the launcher's ordered source list instead of the TA's example paths.
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     # Analyze/elaborate preserves parameter support and round-local WORK isolation.
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     set fd [open [need_env HW1_RTL_LIST] r]
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     set files [split [string trim [read $fd]] \n]
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     close $fd
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     foreach source $files {
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]         if {![file isfile $source]} {
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]             error "Missing RTL: $source"
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]         }
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]         set ::search_path [concat [list [file dirname $source]] $::search_path]
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]         set format [expr {[file extension $source] eq ".sv" ? "sverilog" : "verilog"}]
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]         checked [list analyze -format $format -library WORK $source]
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     }
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     checked [list elaborate $Top -library WORK]
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     current_design $Top
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     checked {link}
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     checked {check_design}
