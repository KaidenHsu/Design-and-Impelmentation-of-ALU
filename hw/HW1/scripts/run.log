HW1_LOG_ONLY:[FLP_adder_4/Delay/Synthesis]     # [Time Units]
HW1_LOG_ONLY:[FLP_adder_4/Delay/Synthesis]     # Save the original unit report, then convert the launcher's ns clock period.
