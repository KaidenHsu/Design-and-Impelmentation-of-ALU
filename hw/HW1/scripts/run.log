HW1_LOG_ONLY:[FLP_mul/Area/Synthesis]         ps 1e-3 \
HW1_LOG_ONLY:[FLP_mul/Area/Synthesis]         fs 1e-6 \
HW1_LOG_ONLY:[FLP_mul/Area/Synthesis]         W 1 \
HW1_LOG_ONLY:[FLP_mul/Area/Synthesis]         mW 1e-3 \
HW1_LOG_ONLY:[FLP_mul/Area/Synthesis]         uW 1e-6 \
