HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] FLP_mul_3 {{from INPUTS to s1_*_reg*/D} {from s1_*_reg*/Q* to s2_*_reg*/D} {from s2_*_reg*/Q* to OUTPUTS}} FLP_adder_4 {{from INPUTS to s1_*_reg*/D} {from s1_*_reg*/Q* to s2_*_reg*/D} {from s2_*_reg*/Q* to s3_*_reg*/D} {from s3_*_reg*/Q* to OUTPUTS}} FLP_adder_7 {{from INPUTS to s1_*_reg*/D} {from s1_*_reg*/Q* to s2_*_reg*/D} {from s2_*_reg*/Q* to s3_*_reg*/D} {from s3_*_reg*/Q* to s4_*_reg*/D} {from s4_*_reg*/Q* to s5_*_reg*/D} {from s5_*_reg*/Q* to s6_*_reg*/D} {from s6_*_reg*/Q* to OUTPUTS}}
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] # Read an optional launcher setting, retaining the course default if absent.
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] proc env_or {name default} {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     if {[info exists ::env($name)]} {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         return $::env($name)
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     return $default
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] # Required settings identify this design, strategy and isolated round.
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] proc need_env {name} {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     if {![info exists ::env($name)]} {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         error "Missing environment variable $name; use scripts/run.sh"
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     return $::env($name)
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] # Some DC commands return 0 on failure instead of raising a Tcl exception.
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] proc checked {script} {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     set result [uplevel 1 $script]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     if {$result eq "0"} {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         error "Command returned failure: $script"
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     return $result
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] # Convert time to ns and power to W for machine-readable measurements.
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] proc unit_scale {number suffix kind} {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     set scales [dict create \
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         s 1e9 \
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         ms 1e6 \
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         us 1e3 \
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         ns 1 \
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         ps 1e-3 \
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         fs 1e-6 \
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         W 1 \
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         mW 1e-3 \
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         uW 1e-6 \
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         nW 1e-9 \
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         pW 1e-12]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     if {![dict exists $scales $suffix]} {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         error "Unsupported $kind unit: $suffix"
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     return [expr {double($number) * [dict get $scales $suffix]}]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] # Extract reported data arrival time and its path endpoints.
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] proc timing_arrival {filename} {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     # Read the positive arrival line, not the negative slack-subtraction line.
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     # Reports can contain one worst path per group; retain the largest arrival.
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     set fd [open $filename r]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     set text [read $fd]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     close $fd
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     set result ""
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     foreach block [split [string map [list "Startpoint:" "\u0001"] $text] "\u0001"] {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         if {[regexp -line \
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]             {^[ \t]*data arrival time[ \t]+([0-9]+\.?[0-9]*(?:[eE][+-]?[0-9]+)?)[ \t\r]*$} $block all number]} {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]             if {$result eq "" || $number > [dict get $result delay]} {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]                 regexp {^[ \t]*([^ \t\n]+)} $block all start
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]                 regexp -line {^[ \t]*Endpoint:[ \t]+([^ \t\n]+)} $block all end
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]                 set result [dict create delay $number start $start end $end]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]             }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     if {$result eq ""} {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         error "No positive data arrival time in $filename"
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     return $result
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] # Resolve stage boundaries to data ports or register pins, excluding clk/rst.
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] proc boundary {pattern} {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     if {$pattern eq "INPUTS"} {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         set ports [all_inputs]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         foreach name {clk rst} {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]             set control [get_ports -quiet $name]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]             if {[sizeof_collection $control]} {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]                 set ports [remove_from_collection $ports $control]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]             }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         return $ports
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     if {$pattern eq "OUTPUTS"} {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         return [all_outputs]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     return [get_pins -hierarchical -quiet $pattern]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] # Read one numeric area field from the original DC report text.
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] proc numeric_area {text label} {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     set pattern [format {%s\s*:\s*([0-9.eE+-]+)} $label]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     if {![regexp -- $pattern $text all number]} {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         error "Missing area field: $label"
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     return $number
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] proc main {} {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     global stage_maps
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     # [Paths, Top Module and Clock Configuration]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     # Retain the TA names. Path_Top is this variant's RTL directory; Path_Syn
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     # is this attempt's gate_level directory. Clk_period is in DC library units.
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     set HW1_Root [file normalize [need_env HW1_ROOT]]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     set Design [need_env HW1_DESIGN]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     set Optimization [need_env HW1_OPT]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     set Path_Top [file join $HW1_Root RTL $Design]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     set Path_Syn [file normalize [need_env HW1_OUT]]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     set Clk_pin "clk"
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     set Clk_period_ns [need_env HW1_PERIOD]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     # Use the TA basename variable for the Verilog export. Other artifact names
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     # stay fixed because post-sim and result collection expect those filenames.
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     set Dump_file_name "netlist"
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     if {$Optimization ni {Area Delay Between}} {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         error "Unknown optimization $Optimization"
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     if {![string is double -strict $Clk_period_ns] || $Clk_period_ns <= 0} {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         error "Invalid period"
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     # Variants reuse top-module names but compile from separate RTL folders.
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     set configurations [dict create \
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         FXP_adder {FXP_adder 1} \
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         FXP_mul {FXP_mul 1} \
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         FLP_adder {FLP_adder 1} \
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         FLP_adder_7 {FLP_adder 7} \
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         FLP_adder_4 {FLP_adder 4} \
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         FLP_mul {FLP_mul 1} \
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         FLP_mul_3 {FLP_mul 3}]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     if {![dict exists $configurations $Design]} {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         error "Unknown design $Design"
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     lassign [dict get $configurations $Design] Top stages
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     set expected [file normalize [file join \
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         $HW1_Root gate_level $Design $Optimization round[need_env HW1_ROUND]]]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     if {$Path_Syn ne $expected} {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         error "Output path does not match the configured design/optimization/round"
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     file mkdir $Path_Syn [file join $Path_Syn work]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     define_design_lib WORK -path [file join $Path_Syn work]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     # [Library and Tool Setup: Original TA Settings]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     set library_root [env_or HW1_LIBRARY_ROOT \
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         /cad/CBDK/ADFP/Executable_Package/Collaterals/IP/stdcell/N16ADFP_StdCell/CCS]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     set ::search_path [concat [list $library_root $Path_Top] $::search_path]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     set ::target_library [list \
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         N16ADFP_StdCellss0p72vm40c_ccs.db \
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         N16ADFP_StdCellff0p88v125c_ccs.db]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     foreach db $::target_library {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         if {![file exists [file join $library_root $db]]} {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]             error "Missing library [file join $library_root $db]"
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     set ::link_library [concat [list *] $::target_library [list dw_foundation.sldb]]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     set ::symbol_library {tsmc040.sdb generic.sdb}
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     set ::synthetic_library dw_foundation.sldb
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     set ::hdlin_translate_off_skip_text "TRUE"
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     set ::edifout_netlist_only "TRUE"
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     set ::verilogout_no_tri true
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     set ::hdlin_enable_presto_for_vhdl "TRUE"
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     # Original TA shell preferences; these do not constrain synthesis timing.
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     set ::sh_enable_line_editing true
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     set ::sh_line_editing_mode emacs
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     history keep 100
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     alias h history
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     # [Read Design File]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     # Use the launcher's ordered source list instead of the TA's example paths.
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     # Analyze/elaborate preserves parameter support and round-local WORK isolation.
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     set fd [open [need_env HW1_RTL_LIST] r]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     set files [split [string trim [read $fd]] \n]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     close $fd
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     foreach source $files {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         if {![file isfile $source]} {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]             error "Missing RTL: $source"
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         set ::search_path [concat [list [file dirname $source]] $::search_path]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         set format [expr {[file extension $source] eq ".sv" ? "sverilog" : "verilog"}]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         checked [list analyze -format $format -library WORK $source]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     checked [list elaborate $Top -library WORK]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     current_design $Top
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     checked {link}
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     checked {check_design}
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     # [Time Units]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     # Save the original unit report, then convert the launcher's ns clock period.
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     redirect -variable units {report_units}
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     set fd [open [file join $Path_Syn units_report.txt] w]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     puts $fd $units
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     close $fd
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     # In "Time_unit : 1.0e-09 Second(ns)", the number multiplies Second.
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     # The parenthesized ns is a label; do not convert the value twice.
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     set unit_pattern {^\s*Time(?:_|\s+)units?\s*:\s*([0-9.eE+-]+)\s*(Seconds?|[munpf]?s)(?:\([^)]*\))?\s*$}
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     if {![regexp -nocase -line $unit_pattern $units match un suffix]} {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         error "Cannot determine library time unit; inspect units_report.txt"
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     set suffix [string tolower $suffix]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     if {$suffix in {second seconds}} {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         set suffix s
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     set time_ns [unit_scale $un $suffix time]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     if {$time_ns <= 0} {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         error "Library time unit must be positive"
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     puts "HW1_DC_UNITS: one library time unit = $time_ns ns"
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     set Clk_period [expr {double($Clk_period_ns) / $time_ns}]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     # [Setting Clock Constraints]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     # Combinational variants use the TA's virtual-clock/max-delay alternative.
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     # Pipelines use the physical clk port and the original clock-network settings.
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     if {$stages == 1} {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         set_max_delay $Clk_period -from [all_inputs] -to [all_outputs]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         create_clock -name $Clk_pin -period $Clk_period
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         set_input_delay 0 -clock $Clk_pin [all_inputs]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     } else {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         set Clock_port [get_ports -quiet $Clk_pin]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         if {![sizeof_collection $Clock_port]} {
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]             error "Pipelined top has no $Clk_pin port"
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         create_clock -name $Clk_pin -period $Clk_period $Clock_port
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         set_fix_hold [get_clocks $Clk_pin]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         set_dont_touch_network [get_clocks $Clk_pin]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         set_ideal_network $Clock_port
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]         set_input_delay 0 -clock $Clk_pin \
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]             [remove_from_collection [all_inputs] $Clock_port]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     set_output_delay 0 -clock $Clk_pin [all_outputs]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis] 
