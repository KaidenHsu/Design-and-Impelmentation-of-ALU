HW1_LOG_ONLY:[FLP_mul_3/Delay/Synthesis]         if {[dict exists $stage_maps $Design] && [llength [dict get $stage_maps $Design]] >= $i} {
HW1_LOG_ONLY:[FLP_mul_3/Delay/Synthesis]             set mapping [lindex [dict get $stage_maps $Design] [expr {$i - 1}]]
HW1_LOG_ONLY:[FLP_mul_3/Delay/Synthesis]             if {[catch {
HW1_LOG_ONLY:[FLP_mul_3/Delay/Synthesis]                 set from [boundary [dict get $mapping from]]
HW1_LOG_ONLY:[FLP_mul_3/Delay/Synthesis]                 set to [boundary [dict get $mapping to]]
HW1_LOG_ONLY:[FLP_mul_3/Delay/Synthesis]                 if {![sizeof_collection $from] || ![sizeof_collection $to]} {
