HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         }
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         create_clock -name $Clk_pin -period $Clk_period $Clock_port
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         set_fix_hold [get_clocks $Clk_pin]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         set_dont_touch_network [get_clocks $Clk_pin]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         set_ideal_network $Clock_port
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         set_input_delay 0 -clock $Clk_pin \
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]             [remove_from_collection [all_inputs] $Clock_port]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     }
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     set_output_delay 0 -clock $Clk_pin [all_outputs]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis] 
