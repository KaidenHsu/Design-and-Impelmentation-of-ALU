HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     # [Each Pipeline Delay]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     # Actual register-bank boundaries replace the TA's example m1/* ... m7/*.
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     # Full path reports provide evidence; stages.tsv feeds report collection.
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     set sf [open [file join $Path_Syn stages.tsv] w]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     for {set i 1} {$i <= $stages && $stages > 1} {incr i} {
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         set delay ""
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         set start ""
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         set end ""
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         set status unmapped
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         if {[dict exists $stage_maps $Design] && [llength [dict get $stage_maps $Design]] >= $i} {
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]             set mapping [lindex [dict get $stage_maps $Design] [expr {$i - 1}]]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]             if {[catch {
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]                 set from [boundary [dict get $mapping from]]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]                 set to [boundary [dict get $mapping to]]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]                 if {![sizeof_collection $from] || ![sizeof_collection $to]} {
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]                     error "Empty stage boundary"
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]                 }
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]                 redirect -file [file join $Path_Syn timing_report_stage${i}.txt] {
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]                     report_timing -from $from -to $to -path full -delay max \
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]                         -nworst 1 -max_paths 1 -significant_digits 6 -sort_by group
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]                 }
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]                 set measured [timing_arrival \
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]                     [file join $Path_Syn timing_report_stage${i}.txt]]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]                 set delay [expr {[dict get $measured delay] * $time_ns}]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]                 set start [dict get $measured start]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]                 set end [dict get $measured end]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]                 set status measured
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]             } issue]} {
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]                 set status invalid
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]                 puts "WARN: stage $i: $issue"
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]                 set delay ""
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]             }
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         } else {
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]             puts "WARN: $Design stage $i mapping is not configured"
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         }
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         puts $sf "$i\t$delay\t$start\t$end\t$status"
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     close $sf
