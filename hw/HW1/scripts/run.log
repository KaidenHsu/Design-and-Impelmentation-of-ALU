HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     set ::link_library [concat [list *] $::target_library [list dw_foundation.sldb]]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     set ::symbol_library {tsmc040.sdb generic.sdb}
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     set ::synthetic_library dw_foundation.sldb
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     set ::hdlin_translate_off_skip_text "TRUE"
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     set ::edifout_netlist_only "TRUE"
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     set ::verilogout_no_tri true
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     set ::hdlin_enable_presto_for_vhdl "TRUE"
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     # Original TA shell preferences; these do not constrain synthesis timing.
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     set ::sh_enable_line_editing true
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     set ::sh_line_editing_mode emacs
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     history keep 100
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     alias h history
