HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis] # Based on ALU_HW1_TA_dc.tcl. Run one design/period per DC process.
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis] # Copied into each round and invoked there: dcnxt_shell -f dc.tcl.
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis] # metadata
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis] set Company "NSYSU2026ALU"
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis] NSYSU2026ALU
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis] set Designer "Kaiden Hsu"
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis] Kaiden Hsu
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis] # Pipeline pin patterns include significand, exponent and sign register banks.
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis] # FLP_mul_3 has two internal register banks and a combinational output stage.
