HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     set ::sh_enable_line_editing true
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     set ::sh_line_editing_mode emacs
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     history keep 100
