HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     [dict create from {s1_*_reg*/Q*} to {s2_*_reg*/D}] \
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     [dict create from {s2_*_reg*/Q*} to {s3_*_reg*/D}] \
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     [dict create from {s3_*_reg*/Q*} to OUTPUTS]]
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis] FLP_mul_3 {{from INPUTS to s1_*_reg*/D} {from s1_*_reg*/Q* to s2_*_reg*/D} {from s2_*_reg*/Q* to OUTPUTS}} FLP_adder_4 {{from INPUTS to s1_*_reg*/D} {from s1_*_reg*/Q* to s2_*_reg*/D} {from s2_*_reg*/Q* to s3_*_reg*/D} {from s3_*_reg*/Q* to OUTPUTS}}
