HW1_LOG_ONLY:[FXP_mul/Between/Synthesis]     # [Automation Measurements]
HW1_LOG_ONLY:[FXP_mul/Between/Synthesis]     # Stable keys feed period tuning/CSV collection. Preserve raw numeric precision.
HW1_LOG_ONLY:[FXP_mul/Between/Synthesis]     set fd [open [file join $Path_Syn metrics.tsv] w]
HW1_LOG_ONLY:[FXP_mul/Between/Synthesis]     foreach {key value} [list \
HW1_LOG_ONLY:[FXP_mul/Between/Synthesis]         schema 1 \
HW1_LOG_ONLY:[FXP_mul/Between/Synthesis]         period_ns $Clk_period_ns \
HW1_LOG_ONLY:[FXP_mul/Between/Synthesis]         slack_ns [expr {$worst * $time_ns}] \
HW1_LOG_ONLY:[FXP_mul/Between/Synthesis]         delay_ns [expr {$critical_delay * $time_ns}] \
HW1_LOG_ONLY:[FXP_mul/Between/Synthesis]         delay_basis timing_report_data_arrival \
HW1_LOG_ONLY:[FXP_mul/Between/Synthesis]         time_unit_ns $time_ns \
HW1_LOG_ONLY:[FXP_mul/Between/Synthesis]         comb_um2 $comb \
HW1_LOG_ONLY:[FXP_mul/Between/Synthesis]         seq_um2 $seq \
HW1_LOG_ONLY:[FXP_mul/Between/Synthesis]         total_um2 $total \
HW1_LOG_ONLY:[FXP_mul/Between/Synthesis]         dynamic_w $dynamic \
HW1_LOG_ONLY:[FXP_mul/Between/Synthesis]         leakage_w $leakage \
HW1_LOG_ONLY:[FXP_mul/Between/Synthesis]         power_w $power \
HW1_LOG_ONLY:[FXP_mul/Between/Synthesis]         power_activity default_estimated \
HW1_LOG_ONLY:[FXP_mul/Between/Synthesis]         area_units TA_library_um2 \
HW1_LOG_ONLY:[FXP_mul/Between/Synthesis]         sdf_corner min_typ_max \
HW1_LOG_ONLY:[FXP_mul/Between/Synthesis]         coverage_status $coverage_status \
HW1_LOG_ONLY:[FXP_mul/Between/Synthesis]         complete 1] {
HW1_LOG_ONLY:[FXP_mul/Between/Synthesis]         puts $fd "$key\t$value"
HW1_LOG_ONLY:[FXP_mul/Between/Synthesis]     }
HW1_LOG_ONLY:[FXP_mul/Between/Synthesis]     close $fd
HW1_LOG_ONLY:[FXP_mul/Between/Synthesis] 
HW1_LOG_ONLY:[FXP_mul/Between/Synthesis]     # TA optional example remains disabled; do not introduce clock-gating analysis.
HW1_LOG_ONLY:[FXP_mul/Between/Synthesis]     # report_clock_gating -gating_elements
HW1_LOG_ONLY:[FXP_mul/Between/Synthesis]     puts "HW1_DC_COMPLETE: $Design $Optimization period=$Clk_period_ns ns"
HW1_LOG_ONLY:[FXP_mul/Between/Synthesis] }
