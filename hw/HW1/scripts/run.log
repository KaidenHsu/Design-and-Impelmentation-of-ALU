HW1_LOG_ONLY:[FXP_adder/Area/Synthesis] # Pipeline pin patterns include significand, exponent and sign register banks.
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis] # FLP_mul_3 has two internal register banks and a combinational output stage.
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis] set stage_maps [dict create]
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis] dict set stage_maps FLP_mul_3 [list \
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis]     [dict create from INPUTS to {s1_*_reg*/D}] \
