HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]             }
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]             if {$worst eq "" || $slack < $worst} {
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]                 set worst $slack
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]             }
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]         }
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     if {$worst eq ""} {
