HW1_LOG_ONLY:[FLP_adder_7/Delay/Synthesis]         mW 1e-3 \
HW1_LOG_ONLY:[FLP_adder_7/Delay/Synthesis]         uW 1e-6 \
HW1_LOG_ONLY:[FLP_adder_7/Delay/Synthesis]         nW 1e-9 \
