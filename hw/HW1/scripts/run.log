HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     lassign [dict get $configurations $Design] Top stages
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     set expected [file normalize [file join \
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         $HW1_Root gate_level $Design $Optimization round[need_env HW1_ROUND]]]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     if {$Path_Syn ne $expected} {
