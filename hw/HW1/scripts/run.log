HW1_LOG_ONLY:[FLP_mul/Area/Synthesis]             }
HW1_LOG_ONLY:[FLP_mul/Area/Synthesis]         }
HW1_LOG_ONLY:[FLP_mul/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_mul/Area/Synthesis]     if {$worst eq ""} {
