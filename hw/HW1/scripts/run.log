HW1_LOG_ONLY:[FXP_mul/Area/Synthesis] 
HW1_LOG_ONLY:[FXP_mul/Area/Synthesis]     # Find the worst setup slack across all path groups, not only one group.
HW1_LOG_ONLY:[FXP_mul/Area/Synthesis]     set worst ""
HW1_LOG_ONLY:[FXP_mul/Area/Synthesis]     foreach_in_collection group [get_path_groups *] {
HW1_LOG_ONLY:[FXP_mul/Area/Synthesis]         set paths [get_timing_paths \
HW1_LOG_ONLY:[FLP_adder/Area/Synthesis] # Based on ALU_HW1_TA_dc.tcl. Run one design/period per DC process.
HW1_LOG_ONLY:[FXP_mul/Area/Synthesis]             -group [get_object_name $group] -delay max -max_paths 1 -nworst 1]
HW1_LOG_ONLY:[FLP_adder/Area/Synthesis] # Copied into each round and invoked there: dcnxt_shell -f dc.tcl.
HW1_LOG_ONLY:[FXP_mul/Area/Synthesis]         foreach_in_collection path $paths {
HW1_LOG_ONLY:[FLP_adder/Area/Synthesis] # metadata
HW1_LOG_ONLY:[FXP_mul/Area/Synthesis]             set slack [get_attribute $path slack]
HW1_LOG_ONLY:[FLP_adder/Area/Synthesis] set Company "NSYSU2026ALU"
