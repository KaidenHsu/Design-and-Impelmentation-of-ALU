HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     set suffix [string tolower $suffix]
HW1_LOG_ONLY:[FLP_adder_4/Area/Synthesis]     if {$suffix in {second seconds}} {
