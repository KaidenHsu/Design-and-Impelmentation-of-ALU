HW1_LOG_ONLY:[FLP_mul/Area/Synthesis]     [dict create from INPUTS to {s1_*_reg*/D}] \
HW1_LOG_ONLY:[FLP_mul/Area/Synthesis]     [dict create from {s1_*_reg*/Q*} to {s2_*_reg*/D}] \
HW1_LOG_ONLY:[FLP_mul/Area/Synthesis]     [dict create from {s2_*_reg*/Q*} to OUTPUTS]]
