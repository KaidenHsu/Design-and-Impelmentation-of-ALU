HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]     set critical_delay [dict get \
HW1_LOG_ONLY:[FLP_adder_4/Between/Synthesis]         [timing_arrival [file join $Path_Syn timing_report.txt]] delay]
