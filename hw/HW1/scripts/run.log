HW1_LOG_ONLY:[FLP_mul/Between/Synthesis]                 set delay ""
HW1_LOG_ONLY:[FLP_mul/Between/Synthesis]             }
HW1_LOG_ONLY:[FLP_mul/Between/Synthesis]         } else {
