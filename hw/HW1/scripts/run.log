HW1_LOG_ONLY:[FLP_mul/Area/Synthesis]     set Path_Top [file join $HW1_Root RTL $Design]
HW1_LOG_ONLY:[FLP_mul/Area/Synthesis]     set Path_Syn [file normalize [need_env HW1_OUT]]
HW1_LOG_ONLY:[FLP_mul/Area/Synthesis]     set Clk_pin "clk"
HW1_LOG_ONLY:[FLP_mul/Area/Synthesis]     set Clk_period_ns [need_env HW1_PERIOD]
HW1_LOG_ONLY:[FLP_mul/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_mul/Area/Synthesis]     # Use the TA basename variable for the Verilog export. Other artifact names
