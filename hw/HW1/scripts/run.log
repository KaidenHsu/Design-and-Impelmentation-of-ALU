HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         $HW1_Root gate_level $Design $Optimization round[need_env HW1_ROUND]]]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     if {$Path_Syn ne $expected} {
