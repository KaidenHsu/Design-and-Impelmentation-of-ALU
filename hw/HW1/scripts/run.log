HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     # Variants reuse top-module names but compile from separate RTL folders.
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     set configurations [dict create \
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         FXP_adder {FXP_adder 1} \
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         FXP_mul {FXP_mul 1} \
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         FLP_adder {FLP_adder 1} \
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         FLP_adder_7 {FLP_adder 7} \
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         FLP_adder_4 {FLP_adder 4} \
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         FLP_mul {FLP_mul 1} \
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         FLP_mul_3 {FLP_mul 3}]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     if {![dict exists $configurations $Design]} {
