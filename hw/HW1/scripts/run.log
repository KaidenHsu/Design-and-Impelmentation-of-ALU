HW1_LOG_ONLY:[FXP_mul/Area/Synthesis]     set unit_pattern {^\s*Time(?:_|\s+)units?\s*:\s*([0-9.eE+-]+)\s*(Seconds?|[munpf]?s)(?:\([^)]*\))?\s*$}
HW1_LOG_ONLY:[FXP_mul/Area/Synthesis]     if {![regexp -nocase -line $unit_pattern $units match un suffix]} {
