HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     puts $fd $units
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     close $fd
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     # In "Time_unit : 1.0e-09 Second(ns)", the number multiplies Second.
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     # The parenthesized ns is a label; do not convert the value twice.
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     set unit_pattern {^\s*Time(?:_|\s+)units?\s*:\s*([0-9.eE+-]+)\s*(Seconds?|[munpf]?s)(?:\([^)]*\))?\s*$}
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     if {![regexp -nocase -line $unit_pattern $units match un suffix]} {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         error "Cannot determine library time unit; inspect units_report.txt"
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     set suffix [string tolower $suffix]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     if {$suffix in {second seconds}} {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         set suffix s
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     set time_ns [unit_scale $un $suffix time]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     if {$time_ns <= 0} {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         error "Library time unit must be positive"
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     puts "HW1_DC_UNITS: one library time unit = $time_ns ns"
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     set Clk_period [expr {double($Clk_period_ns) / $time_ns}]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     # [Setting Clock Constraints]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     # Combinational variants use the TA's virtual-clock/max-delay alternative.
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     # Pipelines use the physical clk port and the original clock-network settings.
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     if {$stages == 1} {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         set_max_delay $Clk_period -from [all_inputs] -to [all_outputs]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         create_clock -name $Clk_pin -period $Clk_period
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         set_input_delay 0 -clock $Clk_pin [all_inputs]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     } else {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         set Clock_port [get_ports -quiet $Clk_pin]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         if {![sizeof_collection $Clock_port]} {
