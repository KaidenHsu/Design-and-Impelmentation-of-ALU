HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     define_name_rules name_rule -allowed "A-Z a-z 0-9 _\[\]" -max_length 255 -type net
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     define_name_rules name_rule -map {{"\\*cell\\*" "cell"}} -case_insensitive
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     change_names -hierarchy -rules name_rule
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     remove_unconnected_ports -blast_buses [get_cells -hierarchical *]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     # [Timing Coverage]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     # Period tuning requires constrained timing paths. Save all diagnostics.
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     redirect -variable coverage {check_timing}
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     set fd [open [file join $Path_Syn check_timing.txt] w]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     puts $fd $coverage
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     close $fd
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     puts $coverage
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     if {[regexp -nocase {(Warning:|Error:)[^\n]*(unconstrained|not constrained|no clock|no input delay|no output delay)} $coverage]} {
