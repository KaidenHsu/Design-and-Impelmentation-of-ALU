HW1_LOG_ONLY:[FLP_adder_7/Delay/Synthesis]     # [Time Units]
HW1_LOG_ONLY:[FLP_adder_7/Delay/Synthesis]     # Save the original unit report, then convert the launcher's ns clock period.
HW1_LOG_ONLY:[FLP_adder_7/Delay/Synthesis]     redirect -variable units {report_units}
HW1_LOG_ONLY:[FLP_adder_7/Delay/Synthesis]     set fd [open [file join $Path_Syn units_report.txt] w]
HW1_LOG_ONLY:[FLP_adder_7/Delay/Synthesis]     puts $fd $units
