HW1_LOG_ONLY:[FXP_adder/Area/Synthesis] }
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis] # Give the launcher a reliable exit status and retain complete Tcl error details.
HW1_LOG_ONLY:[FXP_adder/Area/Synthesis] if {[catch {main} failure options]} {
