HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     # Analyze/elaborate preserves parameter support and round-local WORK isolation.
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     set fd [open [need_env HW1_RTL_LIST] r]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     set files [split [string trim [read $fd]] \n]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     close $fd
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     foreach source $files {
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         if {![file isfile $source]} {
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]             error "Missing RTL: $source"
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         }
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         set ::search_path [concat [list [file dirname $source]] $::search_path]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         set format [expr {[file extension $source] eq ".sv" ? "sverilog" : "verilog"}]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         checked [list analyze -format $format -library WORK $source]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     checked [list elaborate $Top -library WORK]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     current_design $Top
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     checked {link}
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     checked {check_design}
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     # [Time Units]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     # Save the original unit report, then convert the launcher's ns clock period.
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     redirect -variable units {report_units}
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     set fd [open [file join $Path_Syn units_report.txt] w]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     puts $fd $units
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     close $fd
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     # In "Time_unit : 1.0e-09 Second(ns)", the number multiplies Second.
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     # The parenthesized ns is a label; do not convert the value twice.
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     set unit_pattern {^\s*Time(?:_|\s+)units?\s*:\s*([0-9.eE+-]+)\s*(Seconds?|[munpf]?s)(?:\([^)]*\))?\s*$}
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     if {![regexp -nocase -line $unit_pattern $units match un suffix]} {
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         error "Cannot determine library time unit; inspect units_report.txt"
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     set suffix [string tolower $suffix]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     if {$suffix in {second seconds}} {
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         set suffix s
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     set time_ns [unit_scale $un $suffix time]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     if {$time_ns <= 0} {
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         error "Library time unit must be positive"
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     puts "HW1_DC_UNITS: one library time unit = $time_ns ns"
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     set Clk_period [expr {double($Clk_period_ns) / $time_ns}]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis] 
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     # [Setting Clock Constraints]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     # Combinational variants use the TA's virtual-clock/max-delay alternative.
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     # Pipelines use the physical clk port and the original clock-network settings.
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     if {$stages == 1} {
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         set_max_delay $Clk_period -from [all_inputs] -to [all_outputs]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         create_clock -name $Clk_pin -period $Clk_period
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         set_input_delay 0 -clock $Clk_pin [all_inputs]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]     } else {
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         set Clock_port [get_ports -quiet $Clk_pin]
