HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis] 
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     # [Change Naming Rule: Original TA Rules]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     # Escaped brackets keep the literal TA allowed-character set in quoted Tcl.
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     set ::bus_inference_style {%s[%d]}
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     set ::bus_naming_style {%s[%d]}
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     set ::hdlout_internal_busses true
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     change_names -hierarchy -rule verilog
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     define_name_rules name_rule -allowed "A-Z a-z 0-9 _" -max_length 255 -type cell
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     define_name_rules name_rule -allowed "A-Z a-z 0-9 _\[\]" -max_length 255 -type net
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     define_name_rules name_rule -map {{"\\*cell\\*" "cell"}} -case_insensitive
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     change_names -hierarchy -rules name_rule
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     remove_unconnected_ports -blast_buses [get_cells -hierarchical *]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis] 
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     # [Timing Coverage]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     # Period tuning requires constrained timing paths. Save all diagnostics.
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     redirect -variable coverage {check_timing}
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     set fd [open [file join $Path_Syn check_timing.txt] w]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     puts $fd $coverage
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     close $fd
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     puts $coverage
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     if {[regexp -nocase {(Warning:|Error:)[^\n]*(unconstrained|not constrained|no clock|no input delay|no output delay)} $coverage]} {
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         error "Required timing coverage is missing; correct the constraints before tuning"
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     }
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     set coverage_status clean
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     if {[regexp -nocase {Warning:|Error:} $coverage]} {
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         set coverage_status reviewed_with_warnings
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     }
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     if {[regexp -nocase {Warning:|Error:} $coverage] && [env_or HW1_TIMING_REVIEWED 0] ne "1"} {
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         error "check_timing diagnostics require review; see check_timing.txt. Use --input-delays-reviewed only after correcting/reviewing coverage."
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     }
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis] 
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     # [Report Timing]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     # Restore the TA console report and keep the detailed report file.
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     report_timing -significant_digits 6 -sort_by group
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     redirect -file [file join $Path_Syn timing_report.txt] {
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         report_timing -path full -delay max -significant_digits 6 -sort_by group
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     }
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis] 
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     # Find the worst setup slack across all path groups, not only one group.
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     set worst ""
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     foreach_in_collection group [get_path_groups *] {
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         set paths [get_timing_paths \
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]             -group [get_object_name $group] -delay max -max_paths 1 -nworst 1]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         foreach_in_collection path $paths {
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]             set slack [get_attribute $path slack]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]             if {![string is double -strict $slack]} {
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]                 error "Invalid timing attribute"
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]             }
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]             if {$worst eq "" || $slack < $worst} {
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]                 set worst $slack
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]             }
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         }
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     }
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     if {$worst eq ""} {
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         error "No constrained max-delay timing paths"
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     }
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis] 
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     # Reported delay follows the TA's data-arrival-time convention.
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     # Slack remains separate and is used only for timing feasibility/tuning.
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     set critical_delay [dict get \
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         [timing_arrival [file join $Path_Syn timing_report.txt]] delay]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis] 
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     # [Report Area]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     # Use the documented TA library um2 convention, without guessed scaling.
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     redirect -variable area_text {report_area -hier -nosplit}
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     set fd [open [file join $Path_Syn area_report.txt] w]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     puts $fd $area_text
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     close $fd
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     set comb [numeric_area $area_text {Combinational area}]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     set seq [numeric_area $area_text {Noncombinational area}]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     set total [numeric_area $area_text {Total cell area}]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis] 
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     # [Report Power]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     # Keep the TA effort setting and convert explicit report suffixes to W.
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     # Unavailable power fields stay blank rather than becoming invented zeros.
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     set dynamic ""
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     set leakage ""
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     set power ""
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     if {[catch {
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         redirect -variable power_text {report_power -analysis_effort low}
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     } issue]} {
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         puts "WARN: power report unavailable: $issue"
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     } else {
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         set fd [open [file join $Path_Syn power_report.txt] w]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         puts $fd $power_text
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         close $fd
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         if {[regexp {Total Dynamic Power\s*=\s*([0-9.eE+-]+)\s*([munp]?W)} $power_text all number unit]} {
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]             set dynamic [unit_scale $number $unit power]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         }
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         if {[regexp {Cell Leakage Power\s*=\s*([0-9.eE+-]+)\s*([munp]?W)} $power_text all number unit]} {
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]             set leakage [unit_scale $number $unit power]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         }
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         if {$dynamic ne "" && $leakage ne ""} {
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]             set power [expr {$dynamic + $leakage}]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         } else {
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]             puts "WARN: power units/values not extracted; inspect power_report.txt"
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         }
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     }
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis] 
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     # [Each Pipeline Delay]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     # Actual register-bank boundaries replace the TA's example m1/* ... m7/*.
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     # Full path reports provide evidence; stages.tsv feeds report collection.
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     set sf [open [file join $Path_Syn stages.tsv] w]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     for {set i 1} {$i <= $stages && $stages > 1} {incr i} {
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         set delay ""
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         set start ""
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         set end ""
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         set status unmapped
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis] 
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         if {[dict exists $stage_maps $Design] && [llength [dict get $stage_maps $Design]] >= $i} {
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]             set mapping [lindex [dict get $stage_maps $Design] [expr {$i - 1}]]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]             if {[catch {
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]                 set from [boundary [dict get $mapping from]]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]                 set to [boundary [dict get $mapping to]]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]                 if {![sizeof_collection $from] || ![sizeof_collection $to]} {
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]                     error "Empty stage boundary"
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]                 }
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis] 
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]                 redirect -file [file join $Path_Syn timing_report_stage${i}.txt] {
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]                     report_timing -from $from -to $to -path full -delay max \
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]                         -nworst 1 -max_paths 1 -significant_digits 6 -sort_by group
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]                 }
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]                 set measured [timing_arrival \
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]                     [file join $Path_Syn timing_report_stage${i}.txt]]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]                 set delay [expr {[dict get $measured delay] * $time_ns}]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]                 set start [dict get $measured start]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]                 set end [dict get $measured end]
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]                 set status measured
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]             } issue]} {
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]                 set status invalid
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]                 puts "WARN: stage $i: $issue"
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]                 set delay ""
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]             }
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         } else {
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]             puts "WARN: $Design stage $i mapping is not configured"
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         }
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]         puts $sf "$i\t$delay\t$start\t$end\t$status"
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     }
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis]     close $sf
HW1_LOG_ONLY:[FXP_adder/Delay/Synthesis] 
