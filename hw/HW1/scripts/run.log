HW1_LOG_ONLY:[FXP_adder/Between/Synthesis]         create_clock -name $Clk_pin -period $Clk_period
HW1_LOG_ONLY:[FXP_adder/Between/Synthesis]         set_input_delay 0 -clock $Clk_pin [all_inputs]
HW1_LOG_ONLY:[FXP_adder/Between/Synthesis]     } else {
