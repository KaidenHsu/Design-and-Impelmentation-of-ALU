HW1_LOG_ONLY:[FXP_adder/Between/Synthesis] 
HW1_LOG_ONLY:[FXP_adder/Between/Synthesis]     # In "Time_unit : 1.0e-09 Second(ns)", the number multiplies Second.
HW1_LOG_ONLY:[FXP_adder/Between/Synthesis]     # The parenthesized ns is a label; do not convert the value twice.
HW1_LOG_ONLY:[FXP_adder/Between/Synthesis]     set unit_pattern {^\s*Time(?:_|\s+)units?\s*:\s*([0-9.eE+-]+)\s*(Seconds?|[munpf]?s)(?:\([^)]*\))?\s*$}
HW1_LOG_ONLY:[FXP_adder/Between/Synthesis]     if {![regexp -nocase -line $unit_pattern $units match un suffix]} {
