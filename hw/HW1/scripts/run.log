HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     # [Report Timing]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     # Restore the TA console report and keep the detailed report file.
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     report_timing -significant_digits 6 -sort_by group
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     redirect -file [file join $Path_Syn timing_report.txt] {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         report_timing -path full -delay max -significant_digits 6 -sort_by group
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     # Find the worst setup slack across all path groups, not only one group.
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     set worst ""
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     foreach_in_collection group [get_path_groups *] {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         set paths [get_timing_paths \
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]             -group [get_object_name $group] -delay max -max_paths 1 -nworst 1]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         foreach_in_collection path $paths {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]             set slack [get_attribute $path slack]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]             if {![string is double -strict $slack]} {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]                 error "Invalid timing attribute"
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]             }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]             if {$worst eq "" || $slack < $worst} {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]                 set worst $slack
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]             }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     if {$worst eq ""} {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         error "No constrained max-delay timing paths"
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     # Reported delay follows the TA's data-arrival-time convention.
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     # Slack remains separate and is used only for timing feasibility/tuning.
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     set critical_delay [dict get \
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         [timing_arrival [file join $Path_Syn timing_report.txt]] delay]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     # [Report Area]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     # Use the documented TA library um2 convention, without guessed scaling.
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     redirect -variable area_text {report_area -hier -nosplit}
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     set fd [open [file join $Path_Syn area_report.txt] w]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     puts $fd $area_text
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     close $fd
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     set comb [numeric_area $area_text {Combinational area}]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     set seq [numeric_area $area_text {Noncombinational area}]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     set total [numeric_area $area_text {Total cell area}]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     # [Report Power]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     # Keep the TA effort setting and convert explicit report suffixes to W.
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     # Unavailable power fields stay blank rather than becoming invented zeros.
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     set dynamic ""
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     set leakage ""
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     set power ""
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     if {[catch {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         redirect -variable power_text {report_power -analysis_effort low}
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     } issue]} {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         puts "WARN: power report unavailable: $issue"
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     } else {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         set fd [open [file join $Path_Syn power_report.txt] w]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         puts $fd $power_text
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         close $fd
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         if {[regexp {Total Dynamic Power\s*=\s*([0-9.eE+-]+)\s*([munp]?W)} $power_text all number unit]} {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]             set dynamic [unit_scale $number $unit power]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         if {[regexp {Cell Leakage Power\s*=\s*([0-9.eE+-]+)\s*([munp]?W)} $power_text all number unit]} {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]             set leakage [unit_scale $number $unit power]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         if {$dynamic ne "" && $leakage ne ""} {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]             set power [expr {$dynamic + $leakage}]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         } else {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]             puts "WARN: power units/values not extracted; inspect power_report.txt"
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     # [Each Pipeline Delay]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     # Actual register-bank boundaries replace the TA's example m1/* ... m7/*.
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     # Full path reports provide evidence; stages.tsv feeds report collection.
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     set sf [open [file join $Path_Syn stages.tsv] w]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     for {set i 1} {$i <= $stages && $stages > 1} {incr i} {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         set delay ""
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         set start ""
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         set end ""
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         set status unmapped
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         if {[dict exists $stage_maps $Design] && [llength [dict get $stage_maps $Design]] >= $i} {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]             set mapping [lindex [dict get $stage_maps $Design] [expr {$i - 1}]]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]             if {[catch {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]                 set from [boundary [dict get $mapping from]]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]                 set to [boundary [dict get $mapping to]]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]                 if {![sizeof_collection $from] || ![sizeof_collection $to]} {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]                     error "Empty stage boundary"
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]                 }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]                 redirect -file [file join $Path_Syn timing_report_stage${i}.txt] {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]                     report_timing -from $from -to $to -path full -delay max \
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]                         -nworst 1 -max_paths 1 -significant_digits 6 -sort_by group
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]                 }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]                 set measured [timing_arrival \
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]                     [file join $Path_Syn timing_report_stage${i}.txt]]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]                 set delay [expr {[dict get $measured delay] * $time_ns}]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]                 set start [dict get $measured start]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]                 set end [dict get $measured end]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]                 set status measured
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]             } issue]} {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]                 set status invalid
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]                 puts "WARN: stage $i: $issue"
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]                 set delay ""
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]             }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         } else {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]             puts "WARN: $Design stage $i mapping is not configured"
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         puts $sf "$i\t$delay\t$start\t$end\t$status"
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     close $sf
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     # [Write Out]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     # Keep TA commands/options; fixed filenames maintain the automation interface.
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     checked [list write -hierarchy -format ddc \
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         -output [file join $Path_Syn design.ddc]]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     checked [list write -format verilog -hierarchy \
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         -output [file join $Path_Syn ${Dump_file_name}.v]]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     checked [list write_sdf -version 2.1 -context verilog \
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         [file join $Path_Syn timing.sdf]]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     checked [list write_sdc [file join $Path_Syn constraints.sdc]]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     # [Automation Measurements]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     # Stable keys feed period tuning/CSV collection. Preserve raw numeric precision.
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     set fd [open [file join $Path_Syn metrics.tsv] w]
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     foreach {key value} [list \
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         schema 1 \
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         period_ns $Clk_period_ns \
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         slack_ns [expr {$worst * $time_ns}] \
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         delay_ns [expr {$critical_delay * $time_ns}] \
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         delay_basis timing_report_data_arrival \
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         time_unit_ns $time_ns \
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         comb_um2 $comb \
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         seq_um2 $seq \
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         total_um2 $total \
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         dynamic_w $dynamic \
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         leakage_w $leakage \
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         power_w $power \
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         power_activity default_estimated \
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         area_units TA_library_um2 \
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         sdf_corner min_typ_max \
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         coverage_status $coverage_status \
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         complete 1] {
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]         puts $fd "$key\t$value"
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     close $fd
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis] 
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     # TA optional example remains disabled; do not introduce clock-gating analysis.
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     # report_clock_gating -gating_elements
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis]     puts "HW1_DC_COMPLETE: $Design $Optimization period=$Clk_period_ns ns"
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis] }
HW1_LOG_ONLY:[FLP_adder/Delay/Synthesis] # Give the launcher a reliable exit status and retain complete Tcl error details.
