HW1_LOG_ONLY:[FXP_adder/Between/Synthesis]     }
HW1_LOG_ONLY:[FXP_adder/Between/Synthesis]     puts "HW1_DC_UNITS: one library time unit = $time_ns ns"
HW1_LOG_ONLY:[FXP_adder/Between/Synthesis]     set Clk_period [expr {double($Clk_period_ns) / $time_ns}]
HW1_LOG_ONLY:[FXP_adder/Between/Synthesis] 
