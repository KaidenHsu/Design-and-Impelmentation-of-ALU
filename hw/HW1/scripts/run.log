HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         if {[regexp {Total Dynamic Power\s*=\s*([0-9.eE+-]+)\s*([munp]?W)} $power_text all number unit]} {
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]             set dynamic [unit_scale $number $unit power]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         }
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         if {[regexp {Cell Leakage Power\s*=\s*([0-9.eE+-]+)\s*([munp]?W)} $power_text all number unit]} {
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]             set leakage [unit_scale $number $unit power]
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         }
HW1_LOG_ONLY:[FLP_adder_7/Area/Synthesis]         if {$dynamic ne "" && $leakage ne ""} {
