HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     set unit_pattern {^\s*Time(?:_|\s+)units?\s*:\s*([0-9.eE+-]+)\s*(Seconds?|[munpf]?s)(?:\([^)]*\))?\s*$}
HW1_LOG_ONLY:[FLP_adder/Between/Synthesis]     if {![regexp -nocase -line $unit_pattern $units match un suffix]} {
